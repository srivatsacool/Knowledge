{
  "name": "brain-knowledge-hub",
  "version": "1.0.0",
  "description": "Personal knowledge hub & academic study notebook publishing portal",
  "main": "scripts/build.js",
  "scripts": {
    "build": "astro build",
    "build:legacy": "node scripts/build.js",
    "dev": "astro dev",
    "check": "astro check",
    "test": "node scripts/test.js",
    "test:pipeline": "node scripts/test-pipeline.js",
    "test:agent": "node scripts/test-agent-integration.js",
    "test:orca": "node scripts/test-orca-orchestration.js",
    "test:all": "node scripts/test.js && node scripts/test-pipeline.js && node scripts/test-agent-integration.js && node scripts/test-orca-orchestration.js",
    "orca": "node scripts/pipeline/orca-agent.js",
    "pipeline": "node scripts/pipeline/index.js",
    "notebook:create": "node scripts/pipeline/index.js create",
    "notebook:validate": "node scripts/pipeline/index.js validate",
    "notebook:publish": "node scripts/pipeline/index.js publish",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "keywords": [
    "knowledge-hub",
    "academic-notes",
    "study-notebooks",
    "cloudflare-pages",
    "static-site"
  ],
  "author": "Srivatsa",
  "license": "MIT",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.3.5",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "katex": "^0.16.11",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
