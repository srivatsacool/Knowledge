---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandDialog from '../components/paper/CommandDialog.astro';
import '../styles/paper.css';

interface Props {
  title: string;
  description: string;
  stickyHeader?: boolean;
}

const { title, description, stickyHeader = true } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--desk)] text-[var(--text)] transition-colors selection:bg-[var(--hy)] selection:text-[var(--text)]">
    <Header sticky={stickyHeader} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandDialog />
  </body>
</html>
