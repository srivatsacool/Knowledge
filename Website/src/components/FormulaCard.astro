---
import type { FormulaEntry } from '../data/lscmData';

interface Props {
  formula: FormulaEntry;
}

const { formula } = Astro.props;
---

<div id={formula.id} class="paper-card rounded-lg p-6 mb-8 scroll-mt-28">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 mb-4 border-b border-[#E7E5E4] dark:border-[#292524] gap-2">
    <div>
      <h3 class="font-serif text-xl font-bold text-[#1C1917] dark:text-[#F5F5F4]">
        {formula.name}
      </h3>
      <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mt-0.5">
        {formula.description}
      </p>
    </div>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-[#FAF7F0] dark:bg-[#292524] text-[#1E3A8A] dark:text-[#60A5FA] border border-[#E7E5E4] dark:border-[#44403C] self-start sm:self-auto">
      {formula.category}
    </span>
  </div>

  <!-- Primary LaTeX Equation Box -->
  <div class="formula-box p-4 my-4 overflow-x-auto text-center text-lg">
    $${formula.katex}$$
  </div>

  <!-- Variable Definitions Table -->
  <div class="mt-4">
    <h4 class="text-xs font-mono uppercase tracking-wider text-[#78716C] dark:text-[#A8A29E] mb-2 font-semibold">
      Variable Dictionary & Parameters
    </h4>
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left border border-[#E7E5E4] dark:border-[#292524] rounded">
        <thead class="bg-[#FAF7F0] dark:bg-[#141210] text-[#1C1917] dark:text-[#F5F5F4] border-b border-[#E7E5E4] dark:border-[#292524]">
          <tr>
            <th class="p-2 font-mono w-24">Symbol</th>
            <th class="p-2">Economic Definition</th>
            <th class="p-2 font-mono w-28">Standard Unit</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E7E5E4] dark:divide-[#292524] bg-white dark:bg-[#1C1917]">
          {formula.variables.map(v => (
            <tr>
              <td class="p-2 font-mono text-[#1E3A8A] dark:text-[#60A5FA] font-medium">${v.symbol}$</td>
              <td class="p-2 text-[#44403C] dark:text-[#D6D3D1]">{v.definition}</td>
              <td class="p-2 font-mono text-[#78716C] dark:text-[#A8A29E] text-[11px]">{v.unit}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Step-by-Step Arithmetic Example -->
  <div class="mt-5 p-4 bg-[#FAF7F0] dark:bg-[#141210] border border-[#E7E5E4] dark:border-[#292524] rounded-md">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-mono uppercase tracking-wider text-[#B45309] dark:text-[#F59E0B] font-bold">
        Step-by-Step Arithmetic Walkthrough
      </span>
      <span class="text-[10px] font-mono text-[#78716C] dark:text-[#A8A29E]">Numerical Example</span>
    </div>
    
    <div class="text-xs mb-3 text-[#44403C] dark:text-[#D6D3D1]">
      <strong class="font-semibold text-[#1C1917] dark:text-[#F5F5F4]">Given Parameters:</strong>
      <div class="flex flex-wrap gap-2 mt-1">
        {Object.entries(formula.exampleProblem.given).map(([k, v]) => (
          <span class="px-2 py-0.5 bg-white dark:bg-[#24211E] border border-[#E7E5E4] dark:border-[#44403C] rounded font-mono text-[11px]">
            {k}: {v}
          </span>
        ))}
      </div>
    </div>

    <div class="space-y-1 text-xs font-mono text-[#57534E] dark:text-[#A8A29E]">
      {formula.exampleProblem.steps.map(step => (
        <div class="flex items-start space-x-2">
          <span class="text-[#B45309] dark:text-[#F59E0B] font-bold shrink-0">→</span>
          <span>{step}</span>
        </div>
      ))}
    </div>

    <div class="mt-3 pt-2 border-t border-[#E7E5E4] dark:border-[#292524] flex items-center justify-between text-xs font-semibold text-[#047857] dark:text-[#10B981]">
      <span>Calculated Output:</span>
      <span class="font-mono text-sm">{formula.exampleProblem.finalAnswer}</span>
    </div>
  </div>

</div>
