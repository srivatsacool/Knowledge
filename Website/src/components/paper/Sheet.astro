---
interface Props {
  id?: string;
  title?: string;
}

const { id = "mobile-index-sheet", title = "Notebook Index" } = Astro.props;
---

<div 
  id={id} 
  class="mobile-sheet fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
>
  <!-- Backdrop click close -->
  <div id={`${id}-backdrop`} class="absolute inset-0"></div>

  <!-- Slide-out Drawer Panel -->
  <div class="relative w-full max-w-sm sm:max-w-md h-full bg-[var(--paper)] border-r-2 border-[var(--line)] shadow-2xl flex flex-col justify-between overflow-hidden transform transition-transform duration-300 ease-in-out">
    
    <!-- Drawer Header -->
    <div class="p-4 sm:p-5 border-b-2 border-[var(--rule)] bg-[var(--card)] flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <span class="rubber-stamp stamp-green text-[9px]">9-SECTION INDEX</span>
        <h3 id={`${id}-title`} class="font-serif text-lg font-bold text-[var(--ink)]">
          {title}
        </h3>
      </div>
      <button 
        id={`${id}-close-btn`}
        class="w-8 h-8 rounded-lg bg-[var(--paper)] border border-[var(--line)] text-[var(--pencil)] hover:text-[var(--ink)] hover:border-[var(--ink)] flex items-center justify-center text-sm font-bold cursor-pointer transition-colors"
        aria-label="Close Index Drawer"
      >
        ✕
      </button>
    </div>

    <!-- Drawer Content Scroll Area -->
    <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4">
      <slot />
    </div>

    <!-- Drawer Footer -->
    <div class="p-3 bg-[var(--card)] border-t border-[var(--rule)] text-center font-mono text-[11px] text-[var(--pencil)]">
      Press <kbd class="px-1.5 py-0.5 rounded bg-[var(--paper)] border border-[var(--line)] font-bold">ESC</kbd> or tap outside to close
    </div>

  </div>
</div>

<script is:inline define:vars={{ id }}>
  const sheet = document.getElementById(id);
  const closeBtn = document.getElementById(`${id}-close-btn`);
  const backdrop = document.getElementById(`${id}-backdrop`);
  const openBtn = document.getElementById('toolbar-index-btn');

  function openSheet() {
    if (!sheet) return;
    sheet.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeSheet() {
    if (!sheet) return;
    sheet.classList.add('hidden');
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openSheet);
  if (closeBtn) closeBtn.addEventListener('click', closeSheet);
  if (backdrop) backdrop.addEventListener('click', closeSheet);

  // Close when clicking an anchor link inside the drawer
  sheet?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeSheet);
  });

  // ESC to close
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sheet && !sheet.classList.contains('hidden')) {
      closeSheet();
    }
    // Alt+I to toggle
    if (e.altKey && e.key.toLowerCase() === 'i') {
      e.preventDefault();
      if (sheet?.classList.contains('hidden')) openSheet();
      else closeSheet();
    }
  });
</script>
