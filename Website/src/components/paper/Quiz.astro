---
interface Props {
  question: string;
  options: string[];
  correctIndex: number;
  explanation: string;
  id?: string;
}

const { question, options, correctIndex, explanation, id = `quiz-${Math.random().toString(36).substring(2, 7)}` } = Astro.props;
---

<div id={id} class="quiz-box paper-card p-6 my-6 rounded-lg border border-[var(--line)]">
  <div class="flex items-center justify-between mb-3 text-xs font-mono">
    <span class="font-bold text-[var(--ink)]">Conceptual Check / Quiz</span>
    <span class="text-[var(--pencil)]">Active Recall</span>
  </div>

  <h4 class="font-serif text-base font-bold text-[var(--ink)] mb-4">
    {question}
  </h4>

  <div class="space-y-2">
    {options.map((opt, i) => (
      <button 
        type="button"
        onclick={`checkQuizAnswer('${id}', ${i}, ${correctIndex})`}
        class="quiz-opt w-full text-left p-3 rounded text-xs sm:text-sm bg-[var(--paper)] border border-[var(--rule)] hover:border-[var(--ink)] hover:bg-[var(--card)] transition-colors flex items-center justify-between"
        data-index={i}
      >
        <span>{opt}</span>
        <span class="quiz-indicator font-mono font-bold"></span>
      </button>
    ))}
  </div>

  <div id={`${id}-feedback`} class="quiz-feedback hidden mt-4 p-3 rounded text-xs leading-relaxed">
    <p class="font-bold mb-1 feedback-title"></p>
    <p class="feedback-text">{explanation}</p>
  </div>
</div>

<script is:inline>
  window.checkQuizAnswer = function(quizId, selectedIdx, correctIdx) {
    const container = document.getElementById(quizId);
    if (!container) return;
    const buttons = container.querySelectorAll('.quiz-opt');
    const feedback = document.getElementById(quizId + '-feedback');
    const feedbackTitle = feedback?.querySelector('.feedback-title');

    buttons.forEach((btn, idx) => {
      btn.disabled = true;
      const indicator = btn.querySelector('.quiz-indicator');
      if (idx === correctIdx) {
        btn.classList.add('bg-green-100', 'border-green-600', 'text-green-900', 'dark:bg-green-950/40', 'dark:text-green-300');
        if (indicator) indicator.innerText = '✔ Correct';
      } else if (idx === selectedIdx) {
        btn.classList.add('bg-red-100', 'border-red-600', 'text-red-900', 'dark:bg-red-950/40', 'dark:text-red-300');
        if (indicator) indicator.innerText = '✖ Incorrect';
      }
    });

    if (feedback && feedbackTitle) {
      feedback.classList.remove('hidden');
      if (selectedIdx === correctIdx) {
        feedback.classList.add('bg-green-50', 'text-green-800', 'border', 'border-green-300', 'dark:bg-green-950/30', 'dark:text-green-300');
        feedbackTitle.innerText = 'Correct Analysis:';
      } else {
        feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-300', 'dark:bg-red-950/30', 'dark:text-red-300');
        feedbackTitle.innerText = 'Incorrect Analysis — Key Learning:';
      }
    }
  };
</script>
