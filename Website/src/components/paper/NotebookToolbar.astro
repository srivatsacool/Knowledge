---
interface Props {
  title: string;
  domain: { title: string; slug: string };
  subject: { title: string; slug: string };
  slug: string;
}

const { title, domain, subject, slug } = Astro.props;
---

<header class="notebook-toolbar sticky top-0 z-40 bg-[var(--paper)] border-b-2 border-[var(--line)] shadow-xs transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-2">
      
      <!-- Left: Mobile Index Drawer Trigger & Breadcrumb -->
      <div class="flex items-center space-x-2 sm:space-x-3 min-w-0">
        <!-- Index Drawer Trigger (Mobile + Desktop Toggle) -->
        <button 
          id="toolbar-index-btn"
          data-testid="btn-index"
          class="notebook-btn-index px-2.5 py-1.5 rounded-lg bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] font-mono text-xs font-semibold text-[var(--ink)] flex items-center space-x-1.5 shadow-2xs transition-colors cursor-pointer"
          title="Toggle Structured 9-Section Index (Alt+I)"
          aria-label="Toggle Notebook Index"
        >
          <span>📑</span>
          <span class="hidden sm:inline">Index</span>
        </button>

        <!-- Brand / Subject Hierarchy -->
        <div class="flex items-baseline space-x-1.5 text-xs font-mono text-[var(--pencil)] truncate">
          <a href={`/${domain.slug}/`} class="hover:text-[var(--ink)] hover:underline hidden md:inline">{domain.title}</a>
          <span class="hidden md:inline">/</span>
          <a href={`/${domain.slug}/${subject.slug}/`} class="hover:text-[var(--ink)] hover:underline font-semibold text-[var(--text)] truncate">{subject.title}</a>
        </div>
      </div>

      <!-- Center: Current Reading Progress Percentage -->
      <div class="hidden sm:flex items-center space-x-2">
        <span class="font-mono text-xs text-[var(--pencil)]">Progress:</span>
        <span id="reading-percentage" class="font-mono text-xs font-bold text-[var(--ink)] min-w-[3em]">0%</span>
        <div class="w-20 lg:w-32 h-2 rounded-full bg-[var(--rule)] overflow-hidden">
          <div id="progress-bar-fill" class="h-full bg-[var(--ink)] transition-all duration-75" style="width: 0%"></div>
        </div>
      </div>

      <!-- Right: Control Actions [ Search 🔍 ] [ Focus ] [ Light/Dark ] [ Print ] -->
      <div class="flex items-center space-x-1.5 sm:space-x-2 shrink-0">
        
        <!-- Search 🔍 (Command Palette Trigger) -->
        <button 
          id="toolbar-search-btn"
          data-testid="btn-search"
          onclick="window.openSearchPalette ? window.openSearchPalette() : document.getElementById('global-search-trigger')?.click()"
          class="notebook-btn-search px-2.5 py-1.5 rounded-lg bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] text-[var(--pencil)] hover:text-[var(--ink)] font-mono text-xs flex items-center space-x-1.5 shadow-2xs transition-colors cursor-pointer"
          title="Search Notebook (⌘K)"
          aria-label="Search Notebook"
        >
          <svg width="14" height="14" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Search</span>
          <kbd class="hidden md:inline px-1 py-0.2 text-[9px] font-mono bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--pencil)]">⌘K</kbd>
        </button>

        <!-- Focus Mode Toggle -->
        <button 
          id="toolbar-focus-btn"
          data-testid="btn-focus-mode"
          class="notebook-btn-focus px-2.5 py-1.5 rounded-lg bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] text-[var(--pencil)] hover:text-[var(--ink)] font-mono text-xs flex items-center space-x-1 shadow-2xs transition-colors cursor-pointer"
          title="Toggle Immersive Focus Mode (Alt+F)"
          aria-label="Toggle Focus Mode"
        >
          <span id="focus-icon">🎯</span>
          <span class="hidden sm:inline" id="focus-label">Focus</span>
        </button>

        <!-- Light/Dark Mode Switcher -->
        <button 
          id="toolbar-theme-btn"
          data-testid="btn-theme-toggle"
          class="notebook-btn-theme px-2.5 py-1.5 rounded-lg bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] text-[var(--text)] font-mono text-xs flex items-center space-x-1 shadow-2xs transition-colors cursor-pointer"
          title="Switch Light (Paper) / Dark (Night Study) Mode"
          aria-label="Toggle Theme"
        >
          <span class="dark:hidden">☀️ Paper</span>
          <span class="hidden dark:inline">🌙 Dark</span>
        </button>

        <!-- Print / PDF Button -->
        <a 
          href={`/${domain.slug}/${subject.slug}/notebooks/${slug}/print/`}
          target="_blank"
          class="px-2.5 py-1.5 rounded-lg bg-[var(--ink)] text-white hover:bg-[var(--ink2)] font-mono text-xs font-semibold flex items-center space-x-1 shadow-2xs transition-colors"
          title="Printable Paper Edition / PDF Export"
          aria-label="Print Notebook"
        >
          <span>🖨</span>
          <span class="hidden md:inline">Print</span>
        </a>

      </div>

    </div>
  </div>

  <!-- Thin Edge Progress Line (Mobile & Desktop) -->
  <div id="toolbar-reading-progress" class="h-0.5 bg-[var(--ink)] transition-all duration-75" style="width: 0%"></div>
</header>

<script is:inline>
  // Reading progress tracker
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight <= 0) return;
    const progress = Math.min(100, Math.max(0, Math.round((window.scrollY / totalHeight) * 100)));
    
    const fillEl = document.getElementById('progress-bar-fill');
    const textEl = document.getElementById('reading-percentage');
    const edgeEl = document.getElementById('toolbar-reading-progress');
    
    if (fillEl) fillEl.style.width = progress + '%';
    if (textEl) textEl.textContent = progress + '%';
    if (edgeEl) edgeEl.style.width = progress + '%';
  });

  // Focus mode toggle handler
  const focusBtn = document.getElementById('toolbar-focus-btn');
  const focusLabel = document.getElementById('focus-label');
  if (focusBtn) {
    focusBtn.addEventListener('click', () => {
      document.body.classList.toggle('focus-mode');
      const isFocused = document.body.classList.contains('focus-mode');
      if (focusLabel) focusLabel.textContent = isFocused ? 'Exit Focus' : 'Focus';
      localStorage.setItem('brain-focus-mode', isFocused ? 'true' : 'false');
    });

    if (localStorage.getItem('brain-focus-mode') === 'true') {
      document.body.classList.add('focus-mode');
      if (focusLabel) focusLabel.textContent = 'Exit Focus';
    }
  }

  // Index Drawer / Sidebar toggle handler
  const indexBtn = document.getElementById('toolbar-index-btn');
  if (indexBtn) {
    indexBtn.addEventListener('click', () => {
      const sheet = document.getElementById('mobile-index-sheet');
      if (sheet && window.innerWidth < 1024) {
        sheet.classList.remove('hidden');
      } else {
        const sidebar = document.getElementById('notebook-sidebar-container');
        if (sidebar) sidebar.classList.toggle('hidden');
      }
    });
  }

  // Keyboard hotkeys: Alt+F for Focus, Alt+I for Index
  window.addEventListener('keydown', (e) => {
    if (e.altKey && e.key.toLowerCase() === 'f') {
      e.preventDefault();
      focusBtn?.click();
    } else if (e.altKey && e.key.toLowerCase() === 'i') {
      e.preventDefault();
      indexBtn?.click();
    }
  });

  // Light/Dark Theme Switcher
  const themeBtn = document.getElementById('toolbar-theme-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark') || document.documentElement.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      if (newTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      localStorage.setItem('theme', newTheme);
    });
  }
</script>
