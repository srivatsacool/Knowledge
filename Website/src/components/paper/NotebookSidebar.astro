---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NotebookData {
  title: string;
  version: string;
  status: string;
  updated: string;
  professor?: string;
  readingTimeMinutes?: number;
  tags?: string[];
}

interface SisterNotebook {
  data: {
    title: string;
    slug: string;
  };
}

interface Props {
  headings: Heading[];
  notebook: NotebookData;
  sisterNotebooks?: SisterNotebook[];
  currentSlug: string;
  domainSlug: string;
  subjectSlug: string;
}

const {
  headings = [],
  notebook,
  sisterNotebooks = [],
  currentSlug,
  domainSlug,
  subjectSlug,
} = Astro.props;

// Canonical 9 Divisions
const CANONICAL_SECTIONS = [
  { id: 'sec-start', title: 'START', num: '1', icon: '✦', pattern: /^(01\b|1\b|start)/i },
  { id: 'sec-foundations', title: 'FOUNDATIONS', num: '2', icon: '🏛', pattern: /^(02\b|2\b|foundation)/i },
  { id: 'sec-concepts', title: 'CORE CONCEPTS', num: '3', icon: '⚖', pattern: /^(03\b|3\b|core concept)/i },
  { id: 'sec-frameworks', title: 'FRAMEWORKS & MODELS', num: '4', icon: '📐', pattern: /^(04\b|4\b|framework|model)/i },
  { id: 'sec-examples', title: 'WORKED EXAMPLES', num: '5', icon: '✏', pattern: /^(05\b|5\b|worked example|numerical|calculation)/i },
  { id: 'sec-cases', title: 'CASES & APPLICATIONS', num: '6', icon: '🏢', pattern: /^(06\b|6\b|case|application)/i },
  { id: 'sec-pyqs', title: 'PYQs & EXAM BLUEPRINTS', num: '7', icon: '🎓', pattern: /^(07\b|7\b|pyq|examination|past year)/i },
  { id: 'sec-quiz', title: 'QUIZ & REVISION', num: '8', icon: '💡', pattern: /^(08\b|8\b|quiz|revision|recall)/i },
  { id: 'sec-appendix', title: 'APPENDIX & REGISTERS', num: '9', icon: '📚', pattern: /^(09\b|9\b|appendix|register)/i },
];

// Deterministic 1-to-1 heading assignment
const sectionBuckets: Array<{
  id: string;
  title: string;
  num: string;
  icon: string;
  headings: Heading[];
}> = CANONICAL_SECTIONS.map(s => ({ ...s, headings: [] }));

const unassignedHeadings: Heading[] = [];
let currentSectionIdx = -1;

for (const h of headings) {
  // Only consider level 1, 2, 3
  if (h.depth > 3) continue;

  const cleanText = h.text.trim();

  if (h.depth === 1) {
    let matchedIdx = -1;
    for (let i = 0; i < CANONICAL_SECTIONS.length; i++) {
      const sec = CANONICAL_SECTIONS[i];
      if (sec.pattern.test(cleanText)) {
        matchedIdx = i;
        break;
      }
    }

    if (matchedIdx !== -1) {
      currentSectionIdx = matchedIdx;
      sectionBuckets[matchedIdx].headings.push(h);
    } else {
      // If an unnumbered depth 1 heading occurs, assign by keyword or fallback
      if (/overview|scope|metadata|start/i.test(cleanText)) { currentSectionIdx = 0; sectionBuckets[0].headings.push(h); }
      else if (/genesis|history|foundation/i.test(cleanText)) { currentSectionIdx = 1; sectionBuckets[1].headings.push(h); }
      else if (/concept|principle/i.test(cleanText)) { currentSectionIdx = 2; sectionBuckets[2].headings.push(h); }
      else if (/matrix|model|framework/i.test(cleanText)) { currentSectionIdx = 3; sectionBuckets[3].headings.push(h); }
      else if (/drill|worked|example|numerical/i.test(cleanText)) { currentSectionIdx = 4; sectionBuckets[4].headings.push(h); }
      else if (/case|application/i.test(cleanText)) { currentSectionIdx = 5; sectionBuckets[5].headings.push(h); }
      else if (/pyq|exam/i.test(cleanText)) { currentSectionIdx = 6; sectionBuckets[6].headings.push(h); }
      else if (/quiz|recall/i.test(cleanText)) { currentSectionIdx = 7; sectionBuckets[7].headings.push(h); }
      else if (/appendix|register/i.test(cleanText)) { currentSectionIdx = 8; sectionBuckets[8].headings.push(h); }
      else unassignedHeadings.push(h);
    }
  } else if (currentSectionIdx !== -1) {
    // Sub-headings (depth 2 or 3) strictly belong to the current active section
    sectionBuckets[currentSectionIdx].headings.push(h);
  } else {
    unassignedHeadings.push(h);
  }
}

// Helper to clean heading labels in the sidebar
function formatHeadingText(text: string): string {
  return text.replace(/^[0-9]{1,2}\s*[—\-:]\s*/, '').trim();
}
---

<aside id="notebook-sidebar" class="notebook-sidebar space-y-5">
  
  <!-- HERO NAVIGATION: Structured 9-Section Table of Contents -->
  <nav class="paper-card rounded-xl border border-[var(--line)] bg-[var(--card)] shadow-xs overflow-hidden">
    
    <!-- Index Header -->
    <div class="px-4 py-3 bg-[var(--paper)] border-b-2 border-[var(--rule)] flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <span class="font-mono text-xs font-bold text-[var(--ink)]">📑 NOTEBOOK INDEX</span>
      </div>
      <span class="font-mono text-[10px] text-[var(--pencil)] bg-[var(--card)] px-2 py-0.5 rounded border border-[var(--line)]">
        9 Divisions
      </span>
    </div>

    <!-- Scrollable Section List -->
    <div class="p-3 max-h-[72vh] overflow-y-auto space-y-3 divide-y divide-[var(--rule)]">
      {sectionBuckets.map((sec) => {
        if (sec.headings.length === 0) return null;
        
        // Find main section title (the depth 1 heading, if any)
        const mainHeading = sec.headings.find(h => h.depth === 1) || sec.headings[0];
        const subHeadings = sec.headings.filter(h => h !== mainHeading && h.depth <= 3);

        return (
          <div class="index-section pt-2.5 first:pt-0 space-y-1">
            
            <!-- Canonical Group Header Anchor -->
            <div class="flex items-center justify-between group">
              <a 
                href={`#${mainHeading.slug}`}
                class="font-mono text-[11px] uppercase tracking-wider text-[var(--ink)] font-bold hover:text-[var(--ink2)] flex items-center space-x-1.5 transition-colors py-0.5"
              >
                <span class="text-[var(--ink2)]">{sec.num}.</span>
                <span>{sec.title}</span>
              </a>
              <span class="text-[9px] font-mono text-[var(--pencil)] bg-[var(--paper)] px-1.5 py-0.2 rounded border border-[var(--rule)]">
                {sec.headings.length}
              </span>
            </div>

            <!-- Subtopic Links -->
            {subHeadings.length > 0 && (
              <ul class="space-y-0.5 pl-3 border-l-2 border-[var(--rule)] ml-1.5 mt-1">
                {subHeadings.map(h => (
                  <li class="leading-snug">
                    <a 
                      href={`#${h.slug}`} 
                      class={`block py-0.5 truncate transition-colors hover:text-[var(--ink)] hover:underline ${
                        h.depth === 2 
                          ? 'text-xs text-[var(--text)] font-medium' 
                          : 'text-[11px] text-[var(--pencil)] pl-2'
                      }`}
                      title={h.text}
                    >
                      {formatHeadingText(h.text)}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}

      <!-- Unassigned Supplemental Topics (if any) -->
      {unassignedHeadings.length > 0 && (
        <div class="index-section pt-2.5 space-y-1">
          <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--pencil)] font-bold">
            Additional Sections
          </div>
          <ul class="space-y-0.5 pl-2">
            {unassignedHeadings.map(h => (
              <li>
                <a href={`#${h.slug}`} class="block py-0.5 text-xs text-[var(--pencil)] hover:text-[var(--ink)] hover:underline truncate">
                  • {formatHeadingText(h.text)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </nav>

  <!-- Sister Notebooks Navigation -->
  {sisterNotebooks.length > 1 && (
    <div class="paper-card p-3.5 rounded-xl border border-[var(--line)] bg-[var(--paper)] space-y-2 shadow-2xs">
      <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--pencil)] font-bold flex items-center justify-between">
        <span>Subject Notebooks:</span>
        <span class="text-[9px]">{sisterNotebooks.length}</span>
      </div>
      <ul class="space-y-1 text-xs font-sans">
        {sisterNotebooks.map(nb => (
          <li>
            <a 
              href={`/${domainSlug}/${subjectSlug}/notebooks/${nb.data.slug}/`}
              class={`block truncate hover:underline py-0.5 ${nb.data.slug === currentSlug ? 'font-bold text-[var(--ink)] bg-[var(--card)] px-2 py-1 rounded border border-[var(--line)]' : 'text-[var(--pencil)] hover:text-[var(--ink)]'}`}
              title={nb.data.title}
            >
              • {nb.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Compact Archival Passport Strip (Bottom of Sidebar) -->
  <div class="p-3 rounded-lg border border-[var(--line)] bg-[var(--card)] font-mono text-[11px] text-[var(--pencil)] space-y-1.5">
    <div class="flex items-center justify-between">
      <span class="rubber-stamp stamp-green text-[9px]">v{notebook.version}</span>
      <span class="text-[10px] uppercase font-bold text-[var(--ink)]">{notebook.status}</span>
    </div>
    {notebook.professor && (
      <div class="truncate text-[10px]">
        <span class="text-[var(--text)] font-semibold">Faculty:</span> {notebook.professor}
      </div>
    )}
    <div class="text-[10px]">
      <span class="text-[var(--text)] font-semibold">Updated:</span> {notebook.updated}
    </div>
    {notebook.tags && notebook.tags.length > 0 && (
      <div class="pt-1.5 border-t border-[var(--rule)] flex flex-wrap gap-1">
        {notebook.tags.slice(0, 4).map(t => (
          <span class="text-[8px] bg-[var(--paper)] px-1 py-0.2 rounded border border-[var(--line)]">
            #{t}
          </span>
        ))}
      </div>
    )}
  </div>

</aside>
