---
interface Props {
  figureId?: string;
  title: string;
  caption?: string;
  type?: 'flow' | 'architecture' | 'matrix' | 'timeline' | 'hierarchy';
  provenance?: string;
  alt?: string;
}

const {
  figureId = "Figure 1",
  title,
  caption,
  type = "flow",
  provenance = "Standard Academic Model",
  alt = title,
} = Astro.props;
---

<figure class="process-diagram paper-card p-6 my-8 rounded-xl border border-[var(--line)] bg-[var(--card)] shadow-xs">
  <!-- Figure Masthead -->
  <div class="flex flex-wrap items-baseline justify-between gap-2 pb-3 mb-4 border-b border-[var(--rule)]">
    <div class="flex items-center space-x-2">
      <span class="font-mono text-xs font-bold text-[var(--ink)] bg-[var(--paper)] px-2 py-0.5 rounded border border-[var(--line)]">
        {figureId}
      </span>
      <span class="font-serif text-base sm:text-lg font-bold text-[var(--text)]">
        {title}
      </span>
    </div>
    <div class="flex items-center space-x-2">
      <span class="rubber-stamp stamp-blue text-[9px] uppercase">{type}</span>
      {provenance && (
        <span class="font-mono text-[10px] text-[var(--pencil)] hidden sm:inline">Source: {provenance}</span>
      )}
    </div>
  </div>

  <!-- SVG Diagram Canvas -->
  <div class="diagram-canvas p-4 sm:p-6 bg-[var(--paper)] rounded-lg border border-[var(--rule)] flex justify-center items-center overflow-x-auto" role="img" aria-label={alt}>
    <slot />
  </div>

  <!-- Caption & Provenance -->
  {caption && (
    <figcaption class="mt-3 text-xs text-[var(--pencil)] font-sans leading-relaxed border-t border-[var(--rule)] pt-2.5 flex items-start justify-between gap-4">
      <div>
        <strong class="font-mono text-[11px] text-[var(--text)]">{figureId}:</strong> {caption}
      </div>
      {provenance && (
        <span class="font-mono text-[10px] text-[var(--pencil)] shrink-0 sm:hidden">Ref: {provenance}</span>
      )}
    </figcaption>
  )}
</figure>
