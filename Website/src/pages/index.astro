---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allDomains = await getCollection('domains');
const allSubjects = await getCollection('subjects');
const allNotebooks = await getCollection('notebooks');

// Filter featured and recent notebooks
const featuredNotebooks = allNotebooks.filter(nb => nb.data.featured).slice(0, 4);
const recentNotebooks = [...allNotebooks].sort((a, b) => b.data.updated.localeCompare(a.data.updated)).slice(0, 6);

// Total counts for telemetry
const totalDomains = allDomains.length;
const totalSubjects = allSubjects.length;
const totalNotebooks = allNotebooks.length;
const totalInteractive = allNotebooks.filter(nb => nb.data.interactive?.available).length;
---

<BaseLayout 
  title="BRAIN · Personal Knowledge Library" 
  description="A personal public record of what I have studied, understood, explored, built, and documented across operations, analytics, finance, management, AI, and systems."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16">

    <!-- =========================================================
         1. HERO SECTION: ACADEMIC STUDY DESK & LEATHER BLOTTER
         ========================================================= -->
    <section class="desk-blotter p-6 sm:p-12 relative overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--card)] shadow-paper-lg">
      
      <!-- Top Archival Registry Header -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-[var(--line)]">
        <div class="flex items-center space-x-3">
          <span class="w-3 h-3 rounded-full bg-[var(--green)] animate-pulse"></span>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--pencil)]">
            BRAIN · PERSONAL KNOWLEDGE OPERATING SYSTEM
          </span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="rubber-stamp stamp-green text-[10px]">VERIFIED KNOWLEDGE</span>
          <span class="rubber-stamp stamp-amber text-[10px]">PAPER NOTEBOOK 2.0</span>
        </div>
      </div>

      <!-- Main Headline & Scholar Motto -->
      <div class="my-8 max-w-4xl">
        <div class="font-mono text-xs uppercase tracking-widest text-[var(--ink2)] font-bold mb-2">
          CURATED ACADEMIC & TECHNICAL ARCHIVE
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[var(--ink)] leading-[1.15]">
          BRAIN — My Knowledge Library
        </h1>
        <p class="font-sans text-base sm:text-xl text-[var(--pencil)] mt-4 leading-relaxed max-w-3xl">
          A personal public record of what I have studied, understood, explored, built, and documented across operations, analytics, finance, management, AI, and systems.
        </p>

        <!-- Library Catalog Live Search Bar -->
        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <button 
            onclick="document.getElementById('global-search-trigger')?.click()"
            class="px-5 py-3.5 rounded-lg bg-[var(--ink)] text-white hover:bg-[var(--ink2)] font-medium text-xs sm:text-sm flex items-center justify-between space-x-4 shadow-md transition-all cursor-pointer group"
          >
            <div class="flex items-center space-x-3">
              <svg width="18" height="18" class="w-4 h-4 shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span>Search All Domains, Subjects, Formulas & Question Banks...</span>
            </div>
            <kbd class="px-2 py-0.5 text-[11px] font-mono bg-white/20 rounded font-bold">⌘K</kbd>
          </button>

          <a 
            href="/operations/enterprise-resource-planning/" 
            class="px-5 py-3.5 rounded-lg bg-[var(--paper)] border-2 border-[var(--ink)] text-[var(--ink)] hover:bg-[var(--hy)] font-bold text-xs sm:text-sm text-center transition-colors shadow-xs"
          >
            Explore ERP Suite →
          </a>
          <a 
            href="/operations/logistics-supply-chain/" 
            class="px-5 py-3.5 rounded-lg bg-[var(--paper)] border-2 border-[var(--ink)] text-[var(--ink)] hover:bg-[var(--hy)] font-bold text-xs sm:text-sm text-center transition-colors shadow-xs"
          >
            Explore LSCM Suite →
          </a>
        </div>

        <!-- Quick Query Hotkey Pills -->
        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs font-mono text-[var(--pencil)]">
          <span class="text-[11px] uppercase tracking-wider font-bold">Quick Inquiries:</span>
          <button onclick="window.triggerSearch('Fisher Strategic Fit')" class="px-2 py-0.5 rounded bg-[var(--card)] border border-[var(--line)] hover:bg-[var(--hy)] transition-colors cursor-pointer">Fisher Strategic Fit</button>
          <button onclick="window.triggerSearch('EOQ Derivation')" class="px-2 py-0.5 rounded bg-[var(--card)] border border-[var(--line)] hover:bg-[var(--hy)] transition-colors cursor-pointer">EOQ Derivation</button>
          <button onclick="window.triggerSearch('3-Tier Architecture')" class="px-2 py-0.5 rounded bg-[var(--card)] border border-[var(--line)] hover:bg-[var(--hy)] transition-colors cursor-pointer">3-Tier Architecture</button>
          <button onclick="window.triggerSearch('Bullwhip Effect')" class="px-2 py-0.5 rounded bg-[var(--card)] border border-[var(--line)] hover:bg-[var(--hy)] transition-colors cursor-pointer">Bullwhip Effect</button>
          <button onclick="window.triggerSearch('INCOTERMS 2020')" class="px-2 py-0.5 rounded bg-[var(--card)] border border-[var(--line)] hover:bg-[var(--hy)] transition-colors cursor-pointer">INCOTERMS 2020</button>
          <button onclick="window.triggerSearch('CAP Theorem')" class="px-2 py-0.5 rounded bg-[var(--card)] border border-[var(--line)] hover:bg-[var(--hy)] transition-colors cursor-pointer">CAP Theorem</button>
        </div>
      </div>

      <!-- Brass Telemetry Counters -->
      <div class="p-5 sm:p-6 mt-8 rounded-xl bg-[var(--paper)] border border-[var(--line)]">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div class="border-r border-[var(--rule)] last:border-none">
            <span class="block font-serif text-2xl sm:text-4xl font-extrabold text-[var(--ink)]">{totalDomains}</span>
            <span class="text-[10px] sm:text-xs uppercase font-mono tracking-widest text-[var(--pencil)] font-bold">Knowledge Domains</span>
          </div>
          <div class="border-r border-[var(--rule)] last:border-none">
            <span class="block font-serif text-2xl sm:text-4xl font-extrabold text-[var(--ink)]">{totalSubjects}</span>
            <span class="text-[10px] sm:text-xs uppercase font-mono tracking-widest text-[var(--pencil)] font-bold">Subject Portfolios</span>
          </div>
          <div class="border-r border-[var(--rule)] last:border-none">
            <span class="block font-serif text-2xl sm:text-4xl font-extrabold text-[var(--ink)]">{totalNotebooks}</span>
            <span class="text-[10px] sm:text-xs uppercase font-mono tracking-widest text-[var(--pencil)] font-bold">Canonical Notebooks</span>
          </div>
          <div class="border-r border-[var(--rule)] last:border-none">
            <span class="block font-serif text-2xl sm:text-4xl font-extrabold text-[var(--ink)]">{totalInteractive}</span>
            <span class="text-[10px] sm:text-xs uppercase font-mono tracking-widest text-[var(--pencil)] font-bold">Interactive Simulators</span>
          </div>
        </div>
      </div>

    </section>

    <!-- =========================================================
         2. DOMAIN SHELVES: FOLDER TAB AESTHETIC
         ========================================================= -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b-2 border-[var(--ink)] pb-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--pencil)] font-bold">LIBRARY STRUCTURE</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
            Browse the Shelves
          </h2>
        </div>
        <span class="font-mono text-xs text-[var(--pencil)]">
          7 Core Academic Domains
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allDomains.map(d => {
          const subjectsInDomain = allSubjects.filter(s => s.data.domain === d.data.slug);
          const notebooksInDomain = allNotebooks.filter(nb => nb.data.domain === d.data.slug);

          return (
            <div class="paper-card rounded-xl border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] transition-all hover:shadow-md p-6 flex flex-col justify-between group relative overflow-hidden">
              <!-- Top Folder Tab Badge -->
              <div class="flex items-center justify-between mb-3">
                <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--pencil)] font-bold">
                  SHELF // {d.data.slug.toUpperCase()}
                </span>
                <span class="rubber-stamp stamp-blue text-[9px]">
                  {subjectsInDomain.length} Subject{subjectsInDomain.length !== 1 ? 's' : ''}
                </span>
              </div>

              <div>
                <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] transition-colors">
                  <a href={`/${d.data.slug}/`} class="focus:outline-none">
                    {d.data.title}
                  </a>
                </h3>

                <p class="mt-2 text-xs sm:text-sm text-[var(--pencil)] leading-relaxed line-clamp-3">
                  {d.data.description}
                </p>

                <!-- Subject Pills -->
                {subjectsInDomain.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {subjectsInDomain.map(s => (
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--paper)] border border-[var(--line)] text-[var(--pencil)]">
                        {s.data.title.split(' ')[0]}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="mt-6 pt-4 border-t border-[var(--rule)] flex items-center justify-between">
                <span class="font-mono text-xs text-[var(--pencil)]">
                  {notebooksInDomain.length} Notebook{notebooksInDomain.length !== 1 ? 's' : ''}
                </span>
                <a 
                  href={`/${d.data.slug}/`}
                  class="font-mono text-xs font-bold text-[var(--ink)] group-hover:underline flex items-center space-x-1"
                >
                  <span>Open Shelf</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- =========================================================
         3. FEATURED NOTEBOOKS: FLAGSHIP EDITIONS
         ========================================================= -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--amber)] font-bold">RECOMMENDED STUDY</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
            Featured Notebooks
          </h2>
        </div>
        <span class="font-mono text-xs text-[var(--pencil)]">
          Canonical Flagship Editions
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredNotebooks.map(nb => (
          <article class="notebook-sheet p-6 sm:p-8 rounded-xl border border-[var(--line)] bg-[var(--paper)] shadow-paper-md hover:border-[var(--ink)] transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center space-x-2">
                  <span class="rubber-stamp stamp-green text-[9px]">FEATURED</span>
                  <span class="font-mono text-[10px] text-[var(--pencil)] uppercase">v{nb.data.version}</span>
                </div>
                {nb.data.readingTimeMinutes && (
                  <span class="font-mono text-[10px] text-[var(--pencil)]">
                    ~{nb.data.readingTimeMinutes} min read
                  </span>
                )}
              </div>

              <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] transition-colors">
                <a href={`/${nb.data.domain}/${nb.data.subject}/notebooks/${nb.data.slug}/`}>
                  {nb.data.title}
                </a>
              </h3>

              {nb.data.professor && (
                <p class="mt-1 font-mono text-xs text-[var(--pencil)]">
                  Focus: {nb.data.professor}
                </p>
              )}

              <p class="mt-3 text-xs sm:text-sm text-[var(--pencil)] leading-relaxed">
                {nb.data.description}
              </p>

              {nb.data.tags && nb.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {nb.data.tags.map(t => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--card)] border border-[var(--line)] text-[var(--pencil)]">
                      #{t}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="mt-6 pt-4 border-t border-[var(--rule)] flex items-center justify-between">
              <a 
                href={`/${nb.data.domain}/${nb.data.subject}/notebooks/${nb.data.slug}/`}
                class="px-4 py-2 rounded bg-[var(--ink)] text-white hover:bg-[var(--ink2)] font-mono text-xs font-semibold shadow-xs transition-colors"
              >
                Read Notebook →
              </a>

              <a 
                href={`/${nb.data.domain}/${nb.data.subject}/notebooks/${nb.data.slug}/print/`}
                target="_blank"
                class="font-mono text-xs text-[var(--pencil)] hover:text-[var(--ink)] transition-colors"
                title="Printable Paper Edition / PDF"
              >
                🖨 Print / PDF
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- =========================================================
         4. RECENTLY UPDATED NOTEBOOKS
         ========================================================= -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--pencil)] font-bold">CHRONOLOGICAL DISPATCH</span>
          <h2 class="font-serif text-2xl font-bold text-[var(--ink)]">
            Recently Updated Notebooks
          </h2>
        </div>
        <span class="font-mono text-xs text-[var(--pencil)]">
          Latest Revisions
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {recentNotebooks.map(nb => (
          <a 
            href={`/${nb.data.domain}/${nb.data.subject}/notebooks/${nb.data.slug}/`}
            class="paper-card p-5 rounded-lg border border-[var(--line)] bg-[var(--card)] hover:border-[var(--ink)] transition-all hover:shadow-xs group block"
          >
            <div class="flex items-center justify-between text-[10px] font-mono text-[var(--pencil)] mb-2">
              <span class="uppercase font-bold text-[var(--ink2)]">{nb.data.domain}</span>
              <span>{nb.data.updated}</span>
            </div>
            <h4 class="font-serif text-base font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] group-hover:underline transition-colors line-clamp-1">
              {nb.data.title}
            </h4>
            <p class="text-xs text-[var(--pencil)] mt-1.5 line-clamp-2 leading-relaxed">
              {nb.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- =========================================================
         5. EXPLORE BY FORM (MODALITY MATRIX)
         ========================================================= -->
    <section class="paper-card rounded-xl p-8 border border-[var(--line)] bg-[var(--paper)] space-y-6">
      <div>
        <span class="font-mono text-xs uppercase tracking-widest text-[var(--green)] font-bold">
          STUDY METHODOLOGY
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
          Explore by Form
        </h2>
        <p class="text-xs sm:text-sm text-[var(--pencil)] mt-1">
          Four distinct cognitive modalities engineered for deep understanding, retention, and verification.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div class="p-5 rounded-lg bg-[var(--card)] border border-[var(--line)] flex flex-col justify-between">
          <div>
            <div class="font-mono text-sm text-[var(--ink)] font-bold mb-1">01. Canonical Notebooks</div>
            <p class="text-[var(--pencil)] leading-relaxed mt-2">
              Rigorous, proof-backed study texts with 12-point anatomy, mathematical derivations, real-world case studies, and faculty perspectives.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--rule)] font-mono text-[10px] text-[var(--ink)] font-bold">
            11 Published Notebooks →
          </div>
        </div>

        <div class="p-5 rounded-lg bg-[var(--card)] border border-[var(--line)] flex flex-col justify-between">
          <div>
            <div class="font-mono text-sm text-[var(--amber)] font-bold mb-1">02. Interactive Simulators</div>
            <p class="text-[var(--pencil)] leading-relaxed mt-2">
              Parametric models with live parameter sliders to explore sensitivity in EOQ curves, safety stock trade-offs, and INCOTERMS risk frontiers.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--rule)] font-mono text-[10px] text-[var(--amber)] font-bold">
            Live Simulation Engines →
          </div>
        </div>

        <div class="p-5 rounded-lg bg-[var(--card)] border border-[var(--line)] flex flex-col justify-between">
          <div>
            <div class="font-mono text-sm text-[var(--red)] font-bold mb-1">03. Solved Question Banks</div>
            <p class="text-[var(--pencil)] leading-relaxed mt-2">
              Verbatim past examination questions with complete mark breakdowns, step-by-step arithmetic solutions, and exam traps.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--rule)] font-mono text-[10px] text-[var(--red)] font-bold">
            100% Solved Model Answers →
          </div>
        </div>

        <div class="p-5 rounded-lg bg-[var(--card)] border border-[var(--line)] flex flex-col justify-between">
          <div>
            <div class="font-mono text-sm text-[var(--green)] font-bold mb-1">04. Formula References</div>
            <p class="text-[var(--pencil)] leading-relaxed mt-2">
              Exhaustive KaTeX equation cards detailing exact boundary conditions, variable definitions, units of measurement, and numerical proofs.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--rule)] font-mono text-[10px] text-[var(--green)] font-bold">
            Verified KaTeX Formula Bank →
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         6. COLOPHON: PERSONAL PUBLIC KNOWLEDGE BASE
         ========================================================= -->
    <section class="p-6 sm:p-8 rounded-xl border border-[var(--line)] bg-[var(--card)] text-center max-w-3xl mx-auto space-y-3">
      <div class="font-mono text-[10px] uppercase tracking-widest text-[var(--pencil)]">
        COLOPHON & MISSION
      </div>
      <h3 class="font-serif text-xl font-bold text-[var(--ink)]">
        About Brain
      </h3>
      <p class="text-xs sm:text-sm text-[var(--pencil)] leading-relaxed">
        Brain is a personal public knowledge base containing what I have studied, understood, explored, built, and documented over time across operations, quantitative analytics, finance, management, AI, and systems engineering.
      </p>
      <div class="pt-3 font-mono text-[11px] text-[var(--pencil)]">
        Static Architecture · Astro 5 · KaTeX · MDX · Cloudflare Pages Edge
      </div>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  window.triggerSearch = function(query) {
    const trigger = document.getElementById('global-search-trigger');
    if (trigger) trigger.click();
    setTimeout(() => {
      const input = document.getElementById('search-input');
      if (input) {
        input.value = query;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }, 50);
  };
</script>
