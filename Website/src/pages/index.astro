---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allDomains = await getCollection('domains');
const allSubjects = await getCollection('subjects');
const allNotebooks = await getCollection('notebooks');

// Sort domains in canonical academic order
const DOMAIN_ORDER = ['operations', 'analytics', 'finance', 'management', 'business', 'ai', 'technology'];
const sortedDomains = [...allDomains].sort((a, b) => {
  const idxA = DOMAIN_ORDER.indexOf(a.data.slug);
  const idxB = DOMAIN_ORDER.indexOf(b.data.slug);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

// Recently updated notebooks (editorial list format)
const recentlyUpdated = [...allNotebooks]
  .sort((a, b) => b.data.updated.localeCompare(a.data.updated))
  .slice(0, 5);

// Featured flagship notebook
const featuredNotebook = allNotebooks.find(nb => nb.data.slug === 'mrp-planning') 
  || allNotebooks.find(nb => nb.data.slug === 'inventory-optimization') 
  || allNotebooks[0];

// Telemetry counts
const totalDomains = allDomains.length;
const totalSubjects = allSubjects.length;
const totalNotebooks = allNotebooks.length;
const totalInteractive = allNotebooks.filter(nb => nb.data.interactive?.available).length;

// Chronological Knowledge Stream (Recently Learned items)
const recentlyLearnedStream = [
  {
    date: "2026-10-05",
    topic: "Deterministic MRP Matrix Netting & Backward Lead-Time Offsetting",
    domain: "Operations",
    subject: "Enterprise Resource Planning",
    slug: "mrp-planning",
    insight: "Gross demand must never be forecasted for sub-assemblies; BOM explosion calculates exact Planned Order Releases based on lead-time offsets."
  },
  {
    date: "2026-10-04",
    topic: "Stochastic Safety Stock under Joint Demand and Lead-Time Volatility",
    domain: "Operations",
    subject: "Logistics & Supply Chain",
    slug: "inventory-optimization",
    insight: "Lead time variance is amplified by squared demand (D^2), making supplier reliability 25x more impactful than customer forecast refinement."
  },
  {
    date: "2026-10-03",
    topic: "3-Tier Client-Server Architecture & ACID Transactional Boundaries",
    domain: "Operations",
    subject: "Enterprise Resource Planning",
    slug: "erp-foundations",
    insight: "Application servers process business algorithms while normalized RDBMS guarantees transactional ACID isolation across simultaneous terminal commits."
  },
  {
    date: "2026-10-02",
    topic: "Fisher Strategic Fit: Responsive vs Efficient Supply Chains",
    domain: "Operations",
    subject: "Logistics & Supply Chain",
    slug: "scm-architecture-drivers",
    insight: "Functional commodities demand high-utilization cost-minimizing networks; unpredictable innovative products demand buffer capacity and rapid response."
  },
  {
    date: "2026-10-01",
    topic: "CAP Theorem Consistency Proofs in Distributed Storage Engines",
    domain: "Technology",
    subject: "Distributed Systems",
    slug: "cap-theorem-consensus",
    insight: "Network partition tolerance is non-negotiable in physical networks; distributed systems must choose between consistency and availability during split-brain states."
  }
];

// Knowledge Forms
const KNOWLEDGE_FORMS = [
  { form: "Notebooks", count: `${totalNotebooks} Canonical MDX`, desc: "12-point pedagogical study texts with ruled-paper typesetting and complete proof traces." },
  { form: "Frameworks", count: "18 Models", desc: "Strategic and operational blueprints (SAM, Fisher Fit, Leavitt's Diamond, 5 Pillars, SCOR)." },
  { form: "Concepts", count: "120+ Axioms", desc: "Rigorous academic definitions distinguishing core concepts with formal variable notation." },
  { form: "Cases", count: "14 Studies", desc: "Real-world corporate post-mortems analyzing operational breakthroughs and implementation failures." },
  { form: "Formulas", count: "28 Equations", desc: "Authoritative KaTeX mathematical derivations with variable dimension tables and units." },
  { form: "PYQs", count: "45 Solved Exams", desc: "Zero-fabrication university examination questions with 4-pillar model answers." },
  { form: "Interactive Books", count: `${totalInteractive} Simulators`, desc: "Parametric 1600x900 vector simulations with live mathematical parameter recalculation." }
];
---

<BaseLayout 
  title="BRAIN · Personal Knowledge Library" 
  description="A personal academic knowledge library and study notebook archive of what I learn, understand, explore, build, and revisit."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-20">

    <!-- =========================================================
         1. HERO SECTION: ACADEMIC LIBRARY STUDY DESK & MOTTO
         ========================================================= -->
    <section class="desk-blotter p-8 sm:p-14 rounded-2xl border-2 border-[var(--line)] bg-[var(--card)] shadow-paper-lg relative overflow-hidden">
      
      <!-- Archival Registration Header -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b-2 border-[var(--rule)]">
        <div class="flex items-center space-x-3">
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--green)] animate-pulse"></span>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--pencil)] font-bold">
            BRAIN · SCHOLARLY ARCHIVE
          </span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="rubber-stamp stamp-green text-[9px]">VERIFIED 100%</span>
          <span class="rubber-stamp stamp-blue text-[9px]">ACADEMIC EDITION</span>
        </div>
      </div>

      <!-- Main Headline & Scholar Motto -->
      <div class="my-10 max-w-3xl">
        <span class="font-mono text-xs uppercase tracking-widest text-[var(--ink2)] font-bold block mb-2">
          CURATED PERSONAL ARCHIVE
        </span>
        <h1 class="font-serif text-4xl sm:text-6xl font-extrabold tracking-tight text-[var(--ink)] leading-[1.1]">
          BRAIN
        </h1>
        <div class="font-serif text-xl sm:text-3xl text-[var(--text)] font-semibold mt-2 tracking-tight">
          My Knowledge Library
        </div>

        <p class="font-serif text-base sm:text-xl text-[var(--pencil)] mt-5 leading-relaxed italic max-w-2xl border-l-3 border-[var(--ink)] pl-4">
          "A personal archive of what I learn, understand, explore, build, and revisit."
        </p>

        <!-- Primary Action Triggers -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a 
            href="#shelves" 
            class="px-6 py-3.5 rounded-lg bg-[var(--ink)] text-white hover:bg-[var(--ink2)] font-mono text-xs font-bold shadow-md transition-colors flex items-center space-x-2"
          >
            <span>Explore Knowledge Shelves</span>
            <span>↓</span>
          </a>

          <button 
            onclick="window.openSearchPalette ? window.openSearchPalette() : document.getElementById('global-search-trigger')?.click()"
            class="px-5 py-3.5 rounded-lg bg-[var(--paper)] border-2 border-[var(--line)] hover:border-[var(--ink)] text-[var(--text)] font-mono text-xs font-semibold flex items-center space-x-3 shadow-xs transition-colors cursor-pointer group"
          >
            <svg width="16" height="16" class="w-4 h-4 text-[var(--ink)] group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Search Library Catalog...</span>
            <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-[var(--card)] border border-[var(--rule)] rounded text-[var(--pencil)]">⌘K</kbd>
          </button>
        </div>
      </div>

      <!-- Archival Telemetry Brass Ledger -->
      <div class="pt-6 border-t-2 border-[var(--rule)]">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center font-mono">
          <div class="p-3 rounded-lg bg-[var(--paper)] border border-[var(--rule)]">
            <span class="block font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">{totalDomains}</span>
            <span class="text-[10px] uppercase tracking-wider text-[var(--pencil)]">Academic Domains</span>
          </div>
          <div class="p-3 rounded-lg bg-[var(--paper)] border border-[var(--rule)]">
            <span class="block font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">{totalSubjects}</span>
            <span class="text-[10px] uppercase tracking-wider text-[var(--pencil)]">Subject Portfolios</span>
          </div>
          <div class="p-3 rounded-lg bg-[var(--paper)] border border-[var(--rule)]">
            <span class="block font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">{totalNotebooks}</span>
            <span class="text-[10px] uppercase tracking-wider text-[var(--pencil)]">Canonical Notebooks</span>
          </div>
          <div class="p-3 rounded-lg bg-[var(--paper)] border border-[var(--rule)]">
            <span class="block font-serif text-2xl sm:text-3xl font-bold text-[var(--amber)]">{totalInteractive}</span>
            <span class="text-[10px] uppercase tracking-wider text-[var(--pencil)]">Interactive Books</span>
          </div>
        </div>
      </div>

    </section>

    <!-- =========================================================
         2. RECENTLY UPDATED: EDITORIAL LEDGER (NO GENERIC CARDS)
         ========================================================= -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b-2 border-[var(--ink)] pb-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--pencil)] font-bold">DESK DISPATCH</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
            Recently Updated Notebooks
          </h2>
        </div>
        <span class="font-mono text-xs text-[var(--pencil)]">
          Scholarly Revisions
        </span>
      </div>

      <!-- Clean Editorial Ledger List -->
      <div class="divide-y divide-[var(--rule)] border-y border-[var(--rule)] bg-[var(--card)] rounded-xl overflow-hidden shadow-xs">
        {recentlyUpdated.map(nb => (
          <div class="p-4 sm:p-5 hover:bg-[var(--paper)] transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3 group">
            <div class="space-y-1 min-w-0">
              <div class="flex items-center space-x-2 text-[10px] font-mono text-[var(--pencil)]">
                <span class="font-bold uppercase text-[var(--ink2)]">{nb.data.domain}</span>
                <span>•</span>
                <span>{nb.data.subject}</span>
                <span>•</span>
                <span>Updated {nb.data.updated}</span>
              </div>
              <h3 class="font-serif text-base sm:text-lg font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] transition-colors truncate">
                <a href={`/${nb.data.domain}/${nb.data.subject}/notebooks/${nb.data.slug}/`}>
                  {nb.data.title}
                </a>
              </h3>
              <p class="text-xs text-[var(--pencil)] line-clamp-1 max-w-2xl font-sans">
                {nb.data.description}
              </p>
            </div>

            <div class="flex items-center space-x-3 shrink-0 pt-2 sm:pt-0 font-mono text-xs">
              {nb.data.readingTimeMinutes && (
                <span class="text-[var(--pencil)] text-[11px]">~{nb.data.readingTimeMinutes} min</span>
              )}
              <a 
                href={`/${nb.data.domain}/${nb.data.subject}/notebooks/${nb.data.slug}/`}
                class="px-3 py-1.5 rounded bg-[var(--paper)] border border-[var(--line)] group-hover:border-[var(--ink)] text-[var(--ink)] font-bold hover:bg-[var(--ink)] hover:text-white transition-all text-xs"
              >
                Read Notebook →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- =========================================================
         3. BROWSE THE SHELVES: LARGE PHYSICAL ACADEMIC DIVIDERS
         ========================================================= -->
    <section id="shelves" class="space-y-8">
      <div class="flex items-baseline justify-between border-b-2 border-[var(--ink)] pb-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--pencil)] font-bold">PHYSICAL CLASSIFICATION</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
            Browse the Shelves
          </h2>
        </div>
        <span class="font-mono text-xs text-[var(--pencil)]">
          7 Academic Disciplines
        </span>
      </div>

      <!-- Large Academic Dividers (One for each domain) -->
      <div class="space-y-6">
        {sortedDomains.map((d, idx) => {
          const subjectsInDomain = allSubjects.filter(s => s.data.domain === d.data.slug);
          const notebooksInDomain = allNotebooks.filter(nb => nb.data.domain === d.data.slug);

          return (
            <div class="academic-shelf-divider paper-card p-6 sm:p-8 rounded-2xl border-2 border-[var(--line)] bg-[var(--paper)] shadow-paper-md relative overflow-hidden">
              
              <!-- Top Physical Shelf Tab Flag -->
              <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-4 border-b-2 border-[var(--rule)]">
                <div class="flex items-center space-x-3">
                  <span class="font-mono text-xs font-extrabold px-2.5 py-1 rounded bg-[var(--ink)] text-white">
                    SHELF #{idx + 1}
                  </span>
                  <span class="font-mono text-xs uppercase tracking-wider text-[var(--pencil)] font-bold">
                    DOMAIN // {d.data.slug.toUpperCase()}
                  </span>
                </div>
                <div class="flex items-center space-x-2 font-mono text-xs text-[var(--pencil)]">
                  <span>{subjectsInDomain.length} Subject Portfolios</span>
                  <span>•</span>
                  <span>{notebooksInDomain.length} Canonical Notebooks</span>
                </div>
              </div>

              <!-- Domain Title & Scholarly Scope -->
              <div class="max-w-3xl">
                <h3 class="font-serif text-2xl sm:text-3xl font-extrabold text-[var(--ink)]">
                  <a href={`/${d.data.slug}/`} class="hover:underline">
                    {d.data.title}
                  </a>
                </h3>
                <p class="mt-2 text-xs sm:text-sm text-[var(--pencil)] leading-relaxed font-sans">
                  {d.data.description}
                </p>
              </div>

              <!-- Subject Ledger Inside the Shelf -->
              {subjectsInDomain.length > 0 && (
                <div class="mt-6 pt-5 border-t border-[var(--rule)]">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--pencil)] font-bold block mb-3">
                    Curated Subject Portfolios on this Shelf:
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    {subjectsInDomain.map(s => {
                      const nbCount = allNotebooks.filter(nb => nb.data.subject === s.data.slug).length;
                      return (
                        <a 
                          href={`/${d.data.slug}/${s.data.slug}/`}
                          class="p-3.5 rounded-xl bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] transition-colors group flex flex-col justify-between"
                        >
                          <div>
                            <div class="font-serif text-sm font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] group-hover:underline">
                              {s.data.title}
                            </div>
                            {s.data.professor && (
                              <div class="text-[10px] font-mono text-[var(--pencil)] mt-1">
                                Lead: {s.data.professor}
                              </div>
                            )}
                          </div>
                          <div class="mt-3 pt-2 border-t border-[var(--rule)] font-mono text-[10px] text-[var(--pencil)] flex justify-between items-center">
                            <span>{nbCount} Notebook{nbCount !== 1 ? 's' : ''}</span>
                            <span class="text-[var(--ink)] group-hover:translate-x-1 transition-transform">→</span>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}

              <!-- Bottom Action -->
              <div class="mt-6 pt-4 border-t border-[var(--rule)] flex justify-end">
                <a 
                  href={`/${d.data.slug}/`}
                  class="font-mono text-xs font-bold text-[var(--ink)] hover:text-[var(--ink2)] hover:underline flex items-center space-x-1"
                >
                  <span>Open Complete {d.data.title} Shelf</span>
                  <span>→</span>
                </a>
              </div>

            </div>
          );
        })}
      </div>
    </section>

    <!-- =========================================================
         4. FEATURED NOTEBOOK: LARGE EDITORIAL SHOWCASE
         ========================================================= -->
    {featuredNotebook && (
      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b-2 border-[var(--ink)] pb-3">
          <div>
            <span class="font-mono text-xs uppercase tracking-widest text-[var(--amber)] font-bold">FLAGSHIP WORK</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
              Featured Notebook
            </h2>
          </div>
          <span class="font-mono text-xs text-[var(--pencil)]">
            Canonical Master Edition
          </span>
        </div>

        <article class="notebook-sheet p-8 sm:p-12 rounded-2xl border-2 border-[var(--ink)] bg-[var(--paper)] shadow-paper-lg relative overflow-hidden">
          
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-6 border-b-2 border-[var(--rule)]">
            <div class="flex items-center space-x-2">
              <span class="rubber-stamp stamp-green text-[10px]">MASTER EDITION</span>
              <span class="font-mono text-xs font-bold text-[var(--ink)] uppercase">
                {featuredNotebook.data.domain} // {featuredNotebook.data.subject}
              </span>
            </div>
            <div class="flex items-center space-x-3 font-mono text-xs text-[var(--pencil)]">
              <span>Updated {featuredNotebook.data.updated}</span>
              {featuredNotebook.data.readingTimeMinutes && (
                <span>• ~{featuredNotebook.data.readingTimeMinutes} min study</span>
              )}
            </div>
          </div>

          <h3 class="font-serif text-3xl sm:text-4xl font-extrabold text-[var(--ink)] tracking-tight leading-tight">
            <a href={`/${featuredNotebook.data.domain}/${featuredNotebook.data.subject}/notebooks/${featuredNotebook.data.slug}/`}>
              {featuredNotebook.data.title}
            </a>
          </h3>

          {featuredNotebook.data.professor && (
            <p class="font-mono text-xs text-[var(--pencil)] mt-2">
              Faculty Reference: <span class="text-[var(--text)] font-semibold">{featuredNotebook.data.professor}</span>
            </p>
          )}

          <p class="font-sans text-sm sm:text-base text-[var(--pencil)] mt-4 leading-relaxed max-w-3xl">
            {featuredNotebook.data.description}
          </p>

          <!-- Tags -->
          {featuredNotebook.data.tags && (
            <div class="mt-5 flex flex-wrap gap-1.5">
              {featuredNotebook.data.tags.map(t => (
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--card)] border border-[var(--line)] text-[var(--pencil)]">
                  #{t}
                </span>
              ))}
            </div>
          )}

          <!-- Visual Preview Box -->
          <div class="mt-8 p-5 rounded-xl bg-[var(--card)] border border-[var(--line)] space-y-2">
            <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--pencil)] font-bold">
              Pedagogical Architecture Overview:
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div class="p-2.5 rounded bg-[var(--paper)] border border-[var(--rule)]">
                <strong class="text-[var(--ink)] block">01. Theoretical Model</strong>
                <span class="text-[var(--pencil)] text-[11px]">Plossl manufacturing flow and Orlicky demand theorem.</span>
              </div>
              <div class="p-2.5 rounded bg-[var(--paper)] border border-[var(--rule)]">
                <strong class="text-[var(--ink)] block">02. 12-Step Numerical</strong>
                <span class="text-[var(--pencil)] text-[11px]">Explicit step-by-step arithmetic trace with lot sizing.</span>
              </div>
              <div class="p-2.5 rounded bg-[var(--paper)] border border-[var(--rule)]">
                <strong class="text-[var(--ink)] block">03. 7-Part Appendix</strong>
                <span class="text-[var(--pencil)] text-[11px]">Source register, verified PYQs, formulas, and nomenclature.</span>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="mt-8 pt-6 border-t-2 border-[var(--rule)] flex flex-wrap items-center justify-between gap-4">
            <a 
              href={`/${featuredNotebook.data.domain}/${featuredNotebook.data.subject}/notebooks/${featuredNotebook.data.slug}/`}
              class="px-6 py-3 rounded-lg bg-[var(--ink)] text-white hover:bg-[var(--ink2)] font-mono text-xs font-bold shadow-md transition-colors"
            >
              Read Full Notebook →
            </a>

            <div class="flex items-center space-x-3">
              <a 
                href={`/${featuredNotebook.data.domain}/${featuredNotebook.data.subject}/notebooks/${featuredNotebook.data.slug}/print/`}
                target="_blank"
                class="px-3.5 py-2 rounded-lg bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] font-mono text-xs text-[var(--text)] hover:text-[var(--ink)] transition-colors flex items-center space-x-1.5 shadow-2xs"
                title="Printable Paper Edition / PDF Export"
              >
                <span>🖨</span>
                <span>Print / PDF Edition</span>
              </a>
              {featuredNotebook.data.interactive?.available && (
                <span class="rubber-stamp stamp-amber text-[9px]">INTERACTIVE SIM</span>
              )}
            </div>
          </div>

        </article>
      </section>
    )}

    <!-- =========================================================
         5. KNOWLEDGE FORMS: 7 PEDAGOGICAL MODALITIES
         ========================================================= -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b-2 border-[var(--ink)] pb-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--green)] font-bold">COGNITIVE ARCHITECTURE</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
            Knowledge Forms
          </h2>
        </div>
        <span class="font-mono text-xs text-[var(--pencil)]">
          7 Knowledge Modalities
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {KNOWLEDGE_FORMS.map((kf, idx) => (
          <div class="paper-card p-5 rounded-xl border border-[var(--line)] bg-[var(--card)] flex flex-col justify-between shadow-2xs">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-[10px] text-[var(--pencil)]">0{idx + 1}. FORM</span>
                <span class="font-mono text-[10px] font-bold text-[var(--ink)] bg-[var(--paper)] px-2 py-0.5 rounded border border-[var(--rule)]">
                  {kf.count}
                </span>
              </div>
              <h4 class="font-serif text-lg font-bold text-[var(--ink)]">
                {kf.form}
              </h4>
              <p class="mt-2 text-xs text-[var(--pencil)] leading-relaxed font-sans">
                {kf.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- =========================================================
         6. RECENTLY LEARNED: CHRONOLOGICAL KNOWLEDGE STREAM
         ========================================================= -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b-2 border-[var(--ink)] pb-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--pencil)] font-bold">INTELLECTUAL JOURNAL</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
            Recently Learned
          </h2>
        </div>
        <span class="font-mono text-xs text-[var(--pencil)]">
          Chronological Stream
        </span>
      </div>

      <div class="space-y-3 font-sans">
        {recentlyLearnedStream.map(item => (
          <div class="p-4 sm:p-5 rounded-xl bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] transition-colors flex flex-col sm:flex-row sm:items-start justify-between gap-3 shadow-2xs">
            <div class="space-y-1 max-w-3xl">
              <div class="flex items-center space-x-2 text-[10px] font-mono text-[var(--pencil)]">
                <span class="font-bold text-[var(--ink)]">{item.date}</span>
                <span>•</span>
                <span class="uppercase">{item.domain}</span>
                <span>•</span>
                <span>{item.subject}</span>
              </div>
              <h4 class="font-serif text-base font-bold text-[var(--text)]">
                {item.topic}
              </h4>
              <p class="text-xs text-[var(--pencil)] leading-relaxed italic">
                "{item.insight}"
              </p>
            </div>

            <a 
              href={`/operations/enterprise-resource-planning/notebooks/${item.slug}/`}
              class="font-mono text-xs text-[var(--ink2)] hover:underline shrink-0 self-end sm:self-center"
            >
              Examine Source →
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- =========================================================
         7. ABOUT THE ARCHIVE (PERSONAL STATEMENT, ZERO INSTITUTIONAL)
         ========================================================= -->
    <section class="about-archive paper-card p-8 sm:p-12 rounded-2xl border-2 border-[var(--line)] bg-[var(--paper)] space-y-4 shadow-paper-md">
