---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import { PROJECTS } from '../../../../data/projects';
import { LSCM_TOPICS } from '../../../../data/lscmData';

export function getStaticPaths() {
  return PROJECTS.map(p => ({
    params: { domain: p.division, subject: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
---

<ProjectLayout project={project} activeArtifact="notebook" pageSubtitle="Master Exam Notebook 2.0">
  
{project.slug === 'erp' ? (
  <div class="space-y-6">
    <div class="paper-card p-6 rounded-xl border-2 border-[var(--ink)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-2 mb-1">
          <span class="rubber-stamp stamp-green text-[10px]">ENTERPRISE SYSTEMS</span>
          <span class="rubber-stamp stamp-amber text-[10px]">PAPER EDITION 2.0</span>
        </div>
        <h2 class="font-serif text-2xl font-bold text-[var(--ink)]">
          ERP Business Applications Master Notebook
        </h2>
        <p class="font-hand2 text-base text-[var(--pencil)] mt-1">
          Complete 18-Question Examination Revision Textbook with SAP Module Frameworks & BPR Models
        </p>
      </div>
      <a 
        href="/operations/erp/notebook/index.html" 
        target="_blank" 
        class="px-4 py-2.5 rounded-lg bg-[var(--ink)] text-white hover:bg-[var(--ink2)] font-mono text-xs font-bold shrink-0 flex items-center space-x-2 shadow-sm"
      >
        <span>Open Standalone Fullscreen</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Embedded Master Notebook Sheet Frame -->
    <div class="w-full rounded-xl overflow-hidden border-2 border-[var(--line)] shadow-xl bg-white" style="height: 85vh;">
      <iframe src="/operations/erp/notebook/index.html" class="w-full h-full border-0" title="ERP Master Notebook"></iframe>
    </div>
  </div>
) : (
  <div>
  <!-- Template 2.0 Top Study Superpowers Toolbar -->
  <div class="mb-6 p-3 rounded-lg paper-card flex flex-wrap items-center justify-between gap-3 text-xs border border-[var(--line)]">
    
    <!-- Left: Reading Progress -->
    <div class="flex items-center space-x-3">
      <div class="flex items-center space-x-2">
        <span class="font-hand font-bold text-lg text-[var(--ink)]">Reading Progress:</span>
        <span id="reading-pct" class="font-mono font-bold text-sm text-[var(--ink2)]">0%</span>
      </div>
      <div class="w-24 sm:w-36 h-2 rounded-full bg-[var(--rule)] overflow-hidden">
        <div id="reading-bar" class="h-full bg-gradient-to-r from-[var(--ink)] to-[var(--ink2)] w-0 transition-all duration-150"></div>
      </div>
    </div>

    <!-- Center: Pomodoro Study Timer -->
    <div class="flex items-center space-x-2 px-3 py-1 rounded bg-[var(--paper)] border border-[var(--line)]">
      <span class="text-sm">⏱</span>
      <span id="pomodoro-display" class="font-mono font-bold text-xs text-[var(--ink)]">25:00</span>
      <button id="pomo-toggle" class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[var(--ink)] text-white hover:opacity-90">Start</button>
      <button id="pomo-reset" class="px-1.5 py-0.5 rounded text-[10px] font-mono text-[var(--pencil)] hover:underline">↺</button>
    </div>

    <!-- Right: Text-to-Speech & Font Sizing -->
    <div class="flex items-center space-x-2">
      <button id="tts-btn" class="px-2.5 py-1 rounded bg-[var(--paper)] border border-[var(--line)] font-hand font-bold text-xs hover:bg-[var(--hy)] flex items-center space-x-1">
        <span>🔊 Read Aloud</span>
      </button>
      <button onclick="adjustFontSize(-1)" class="w-7 h-7 rounded bg-[var(--paper)] border border-[var(--line)] font-bold font-serif hover:bg-[var(--hy)]">A-</button>
      <button onclick="adjustFontSize(1)" class="w-7 h-7 rounded bg-[var(--paper)] border border-[var(--line)] font-bold font-serif hover:bg-[var(--hy)]">A+</button>
    </div>

  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    <!-- Sidebar / TOC Index with Checkmarks -->
    <aside class="lg:col-span-1 hidden lg:block">
      <div class="sticky top-32 paper-card rounded-lg p-4 max-h-[82vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-2 mb-3 border-b border-[var(--line)]">
          <h3 class="font-hand font-bold text-xl text-[var(--ink)]">
            Index & Mastery
          </h3>
          <span class="font-mono text-[10px] text-[var(--pencil)]">15 Topics</span>
        </div>

        <!-- Faculty Filter Buttons -->
        <div class="flex flex-wrap gap-1 mb-4 pb-2 border-b border-[var(--line)]">
          <button onclick="filterFaculty('all')" class="faculty-btn active px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--ink)] text-white">All (15)</button>
          <button onclick="filterFaculty('Ajit Sir')" class="faculty-btn px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--paper)] border border-[var(--line)]">Ajit Sir</button>
          <button onclick="filterFaculty('Manoj Sir')" class="faculty-btn px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--paper)] border border-[var(--line)]">Manoj Sir</button>
          <button onclick="filterFaculty('Praful Sir')" class="faculty-btn px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--paper)] border border-[var(--line)]">Praful Sir</button>
        </div>

        <nav class="space-y-1 text-xs">
          {LSCM_TOPICS.map(t => (
            <a 
              href={`#topic-${t.id}`}
              class="topic-nav-link flex items-center justify-between p-1.5 rounded hover:bg-[var(--hy)] text-[var(--text)] transition-colors group"
              data-faculty={t.faculty}
            >
              <div class="truncate mr-2">
                <span class="font-mono text-[10px] text-[var(--pencil)] mr-1">{t.id.toString().padStart(2, '0')}.</span>
                <span class="group-hover:text-[var(--ink)] font-medium">{t.title}</span>
              </div>
              <span class="w-4 h-4 rounded border border-[var(--pencil)] flex items-center justify-center text-[10px] text-[var(--green)] font-bold shrink-0">✓</span>
            </a>
          ))}
        </nav>

        <!-- Standalone Professor Editions Section -->
        <div class="mt-6 pt-4 border-t border-[var(--line)] space-y-2">
          <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--ink)] font-bold block">
            Dedicated Faculty Portfolios:
          </span>
          <a href="/operations/lscm-archive/01_Ajit_Sir_LSCM_Notebook.html" target="_blank" class="block p-1.5 rounded hover:bg-[var(--hy)] text-[11px] font-medium text-[var(--ink)]">
            🏛️ Prof. Ajit Maurya ↗
          </a>
          <a href="/operations/lscm-archive/02_Manoj_Sir_LSCM_Notebook.html" target="_blank" class="block p-1.5 rounded hover:bg-[var(--hy)] text-[11px] font-medium text-[var(--ink)]">
            📦 Prof. Manoj Dagaonkar ↗
          </a>
          <a href="/operations/lscm-archive/03_Praful_Sir_LSCM_Notebook.html" target="_blank" class="block p-1.5 rounded hover:bg-[var(--hy)] text-[11px] font-medium text-[var(--ink)]">
            🧮 Prof. Praful More ↗
          </a>
          <a href="/operations/lscm-archive/04_LSCM_Complete_Syllabus_PYQ_Master_Notebook.html" target="_blank" class="block p-1.5 rounded hover:bg-[var(--hy)] text-[11px] font-medium text-[var(--red)]">
            📘 Master Syllabus & PYQs ↗
          </a>
        </div>
      </div>
    </aside>

    <!-- PHYSICAL NOTEBOOK 2.0 SHEET -->
    <div class="lg:col-span-3">
      
      <div class="notebook-sheet relative">
        
        <!-- Physical Tab Flag sticking out on right -->
        <div class="tabflag">
          LSCM 2026 · EXAM BLUEPRINT
        </div>

        <!-- Notebook Header & Stamped Title -->
        <div class="mb-10 pb-6 border-b border-[var(--line)]">
          
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="rubber-stamp stamp-green">MBA CORE CURRICULUM</span>
            <span class="rubber-stamp stamp-red">100% SOLVED PYQS</span>
            <span class="rubber-stamp stamp-amber">PAPER EDITION 2.0</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--ink)] tracking-tight leading-tight">
            Logistics & Supply Chain Management
          </h1>

          <p class="font-hand2 text-lg text-[var(--pencil)] mt-2">
            Complete 15-Session Consulting & Exam Master Blueprint · Academic Reference Edition
          </p>

          <!-- Yellow Post-It Note with Washi Tape -->
          <div class="sticky-note sticky-yellow max-w-xl">
            <strong>Professor Synthesis Guidance:</strong>
            <ul class="list-disc pl-5 mt-1 space-y-0.5 text-sm">
              <li><strong>Ajit Sir:</strong> Focus heavily on Fisher's Strategic Fit matrix, the 6 Drivers, S&OP cycles, and Tapering transportation economics.</li>
              <li><strong>Manoj Sir:</strong> Perfect the U-shaped warehouse layout, cross-docking prerequisites, and selective vs. drive-in rack trade-offs.</li>
              <li><strong>Praful Sir:</strong> Always show complete first-order algebraic derivations for EOQ/EPQ, and write every arithmetic step with explicit units!</li>
            </ul>
          </div>
        </div>

        <!-- 15 TOPICS RENDERED CONSECUTIVELY -->
        <div class="space-y-16" id="notebook-content">
          {LSCM_TOPICS.map(topic => (
            <article id={`topic-${topic.id}`} class="topic-article pt-6 scroll-mt-24" data-faculty={topic.faculty}>
              
              <!-- Topic Header with Stamps & Badges -->
              <div class="pb-3 mb-6 border-b-2 border-[var(--ink)] flex flex-wrap items-center justify-between gap-2">
                <div>
                  <div class="flex items-center space-x-2 text-xs font-mono text-[var(--pencil)] mb-1">
                    <span class="font-bold text-[var(--ink2)]">SESSION {topic.session.toString().padStart(2, '0')}</span>
                    <span>•</span>
                    <span class="font-hand font-bold text-sm text-[var(--red)]">{topic.faculty}</span>
                    <span>•</span>
                    <span>{topic.category}</span>
                  </div>
                  <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--ink)]">
                    {topic.id}. {topic.title}
                  </h2>
                </div>

                <div class="flex items-center space-x-2">
                  <span class="rubber-stamp stamp-red">EXAM FAVORITE</span>
                </div>
              </div>

              <!-- Content Breakdown (12-Point Architecture) -->
              <div class="space-y-6 text-base leading-relaxed">
                
                <!-- 1. What is it? -->
                <div>
                  <h3 class="font-hand font-bold text-xl text-[var(--ink)] flex items-center space-x-2">
                    <span class="text-base font-mono">§1</span>
                    <span>Authoritative Definition (What is it?)</span>
                  </h3>
                  <p class="mt-1 bg-[var(--card)] p-4 rounded-md border-l-4 border-[var(--ink)] shadow-xs">
                    {topic.what}
                  </p>
                </div>

                <!-- 2. Why does it matter? -->
                <div>
                  <h3 class="font-hand font-bold text-xl text-[var(--ink)] flex items-center space-x-2">
                    <span class="text-base font-mono">§2</span>
                    <span>Strategic Business Rationale (Why does it matter?)</span>
                  </h3>
                  <p class="mt-1">
                    {topic.why}
                  </p>
                </div>

                <!-- 3. How does it work? -->
                <div>
                  <h3 class="font-hand font-bold text-xl text-[var(--ink)] flex items-center space-x-2">
                    <span class="text-base font-mono">§3</span>
                    <span>Operational Mechanics & Execution (How does it work?)</span>
                  </h3>
                  <p class="mt-1">
                    {topic.how}
                  </p>
                </div>

                <!-- 4. Theoretical Framework -->
                <div>
                  <h3 class="font-hand font-bold text-xl text-[var(--amber)] flex items-center space-x-2">
                    <span class="text-base font-mono">§4</span>
                    <span>Core Theoretical Framework</span>
                  </h3>
                  <div class="mt-1 p-3 bg-[var(--card)] border border-[var(--line)] rounded-md font-medium text-[var(--ink)]">
                    {topic.framework}
                  </div>
                </div>

                <!-- 5. Mathematical Formulation (if applicable) -->
                {topic.formulaKatex && (
                  <div>
                    <h3 class="font-hand font-bold text-xl text-[var(--green)] flex items-center space-x-2">
                      <span class="text-base font-mono">§5</span>
                      <span>Mathematical Model & KaTeX Formulation</span>
                    </h3>
                    <div class="formula-box p-4 my-2 text-center text-xl overflow-x-auto">
                      $${topic.formulaKatex}$$
                    </div>

                    {topic.arithmeticExample && (
                      <div class="mt-3 p-4 bg-[var(--card)] border border-[var(--line)] rounded-md font-mono text-xs space-y-1.5">
                        <div class="font-bold text-[var(--amber)] text-sm mb-1">
                          Step-by-Step Numerical Walkthrough:
                        </div>
                        <div class="text-[var(--pencil)] italic mb-2">{topic.arithmeticExample.problem}</div>
                        {topic.arithmeticExample.steps.map(st => (
                          <div class="flex items-start space-x-2">
                            <span class="text-[var(--ink2)] font-bold">→</span>
                            <span>{st}</span>
                          </div>
                        ))}
                        <div class="pt-2 border-t border-[var(--line)] font-bold text-[var(--green)] text-sm">
                          Conclusion: {topic.arithmeticExample.result}
                        </div>
                      </div>
                    )}
                  </div>
                )}

                <!-- 6. Real-World Corporate Example -->
                <div>
                  <h3 class="font-hand font-bold text-xl text-[var(--ink)] flex items-center space-x-2">
                    <span class="text-base font-mono">§6</span>
                    <span>Corporate Benchmark Case</span>
                  </h3>
                  <p class="mt-1 italic bg-[var(--card)] p-3 rounded border border-[var(--line)]">
                    "{topic.businessExample}"
                  </p>
                </div>

                <!-- Faculty Emphasis Sticky Note -->
                <div class="sticky-note sticky-blue">
                  <strong class="font-hand font-bold text-base text-[var(--ink)]">Professor's Exam Hall Warning ({topic.faculty}):</strong>
                  <p class="mt-0.5 text-sm">{topic.facultyEmphasis}</p>
                </div>

                <!-- Verified Past PYQ Mapping -->
                <div class="p-3 bg-[var(--card)] rounded border border-[var(--line)] flex items-start justify-between">
                  <div>
                    <div class="font-mono text-xs uppercase tracking-wider text-[var(--red)] font-bold">
                      Verified Past-Year Exam Recurrence
                    </div>
                    <p class="text-xs text-[var(--pencil)] mt-1 font-mono">
                      {topic.pyqReference}
                    </p>
                  </div>
                  <a href="/operations/lscm/pyq/" class="px-2 py-1 text-xs font-mono rounded bg-[var(--red)] text-white shrink-0 hover:opacity-90">
                    View Solution →
                  </a>
                </div>

                <!-- Model Exam Answer Blueprint -->
                <div class="pt-4 border-t border-[var(--line)]">
                  <h3 class="font-hand font-bold text-xl text-[var(--green)] mb-2">
                    High-Scoring MBA Exam Answer Structure
                  </h3>
                  <div class="space-y-1.5 p-4 bg-[var(--card)] rounded border border-[var(--line)] text-xs text-[var(--text)]">
                    {topic.examAnswerFormat.map(item => (
                      <div class="flex items-start space-x-2">
                        <span class="text-[var(--green)] font-bold font-mono">✔</span>
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>
                </div>

              </div>

            </article>
          ))}
        </div>

      </div>

    </div>

  </div>
  </div>
)}

</ProjectLayout>

<script is:inline>
  // KaTeX auto-render trigger for dynamic math
  if (typeof renderMathInElement === 'function') {
    renderMathInElement(document.body, {
      delimiters: [
        {left: '$$', right: '$$', display: true},
        {left: '$', right: '$', display: false}
      ],
      throwOnError: false
    });
  }
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof renderMathInElement === 'function') {
      renderMathInElement(document.body, {
        delimiters: [
          {left: '$$', right: '$$', display: true},
          {left: '$', right: '$', display: false}
        ],
        throwOnError: false
      });
    }
  });

  // Reading Progress Bar
  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const top = doc.scrollTop || document.body.scrollTop;
    const height = doc.scrollHeight - doc.clientHeight;
    const progress = height > 0 ? Math.min(100, Math.round((top / height) * 100)) : 0;
    
    const bar = document.getElementById('reading-bar');
    const pct = document.getElementById('reading-pct');
    if (bar) bar.style.width = progress + '%';
    if (pct) pct.innerText = progress + '%';
  });

  // Pomodoro Timer
  let pomoSeconds = 25 * 60;
  let pomoInterval = null;
  const pomoDisplay = document.getElementById('pomodoro-display');
  const pomoBtn = document.getElementById('pomo-toggle');
  const pomoReset = document.getElementById('pomo-reset');

  if (pomoBtn) {
    pomoBtn.addEventListener('click', () => {
      if (pomoInterval) {
        clearInterval(pomoInterval);
        pomoInterval = null;
        pomoBtn.innerText = 'Resume';
      } else {
        pomoInterval = setInterval(() => {
          if (pomoSeconds > 0) {
            pomoSeconds--;
            const m = Math.floor(pomoSeconds / 60).toString().padStart(2, '0');
            const s = (pomoSeconds % 60).toString().padStart(2, '0');
            if (pomoDisplay) pomoDisplay.innerText = `${m}:${s}`;
          } else {
            clearInterval(pomoInterval);
            pomoInterval = null;
            alert('Pomodoro completed! Take a 5-minute study break.');
          }
        }, 1000);
        pomoBtn.innerText = 'Pause';
      }
    });
  }

  if (pomoReset) {
    pomoReset.addEventListener('click', () => {
      clearInterval(pomoInterval);
      pomoInterval = null;
      pomoSeconds = 25 * 60;
      if (pomoDisplay) pomoDisplay.innerText = '25:00';
      if (pomoBtn) pomoBtn.innerText = 'Start';
    });
  }

  // Font Size Adjuster
  let currentFontSize = 16;
  function adjustFontSize(delta) {
    currentFontSize = Math.min(22, Math.max(14, currentFontSize + delta));
    const content = document.getElementById('notebook-content');
    if (content) {
      content.style.fontSize = currentFontSize + 'px';
    }
  }

  // TTS Read Aloud
  const ttsBtn = document.getElementById('tts-btn');
  let isSpeaking = false;
  if (ttsBtn) {
    ttsBtn.addEventListener('click', () => {
      if ('speechSynthesis' in window) {
        if (isSpeaking) {
          window.speechSynthesis.cancel();
          isSpeaking = false;
          ttsBtn.innerText = '🔊 Read Aloud';
        } else {
          const text = document.getElementById('notebook-content')?.innerText.slice(0, 1500) || '';
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.rate = 1.0;
          utterance.onend = () => {
            isSpeaking = false;
            ttsBtn.innerText = '🔊 Read Aloud';
          };
          window.speechSynthesis.speak(utterance);
          isSpeaking = true;
          ttsBtn.innerText = '⏹ Stop Voice';
        }
      } else {
        alert('Text-to-speech is not supported in this browser.');
      }
    });
  }

  // Faculty Filtering
  function filterFaculty(faculty) {
    const articles = document.querySelectorAll('.topic-article');
    const navLinks = document.querySelectorAll('.topic-nav-link');
    const buttons = document.querySelectorAll('.faculty-btn');

    buttons.forEach(btn => {
      if (btn.innerText.includes(faculty) || (faculty === 'all' && btn.innerText.includes('All'))) {
        btn.classList.add('bg-[var(--ink)]', 'text-white');
        btn.classList.remove('bg-[var(--paper)]');
      } else {
        btn.classList.remove('bg-[var(--ink)]', 'text-white');
        btn.classList.add('bg-[var(--paper)]');
      }
    });

    articles.forEach(art => {
      const artFaculty = art.getAttribute('data-faculty');
      if (faculty === 'all' || artFaculty === faculty || artFaculty === 'Consensus') {
        art.classList.remove('hidden');
      } else {
        art.classList.add('hidden');
      }
    });

    navLinks.forEach(link => {
      const linkFaculty = link.getAttribute('data-faculty');
      if (faculty === 'all' || linkFaculty === faculty || linkFaculty === 'Consensus') {
        link.classList.remove('hidden');
      } else {
        link.classList.add('hidden');
      }
    });
  }
</script>
