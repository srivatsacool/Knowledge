---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

import NotebookToolbar from '../../../../components/paper/NotebookToolbar.astro';
import NotebookSidebar from '../../../../components/paper/NotebookSidebar.astro';
import Sheet from '../../../../components/paper/Sheet.astro';

import StickyNote from '../../../../components/paper/StickyNote.astro';
import Stamp from '../../../../components/paper/Stamp.astro';
import Callout from '../../../../components/paper/Callout.astro';
import FormulaCard from '../../../../components/paper/FormulaCard.astro';
import WorkedExample from '../../../../components/paper/WorkedExample.astro';
import ProcessDiagram from '../../../../components/paper/ProcessDiagram.astro';
import PYQSection from '../../../../components/paper/PYQSection.astro';
import PYQCard from '../../../../components/paper/PYQCard.astro';
import AppendixRegister from '../../../../components/paper/AppendixRegister.astro';
import ComparisonCard from '../../../../components/paper/ComparisonCard.astro';
import DiagramCard from '../../../../components/paper/DiagramCard.astro';
import QuestionCard from '../../../../components/paper/QuestionCard.astro';
import Flashcard from '../../../../components/paper/Flashcard.astro';
import Quiz from '../../../../components/paper/Quiz.astro';
import RelatedKnowledge from '../../../../components/paper/RelatedKnowledge.astro';
import Highlighter from '../../../../components/paper/Highlighter.astro';
import HandwrittenAnnotation from '../../../../components/paper/HandwrittenAnnotation.astro';

export async function getStaticPaths() {
  const notebooks = await getCollection('notebooks');
  const allDomains = await getCollection('domains');
  const allSubjects = await getCollection('subjects');

  const paths = [];

  for (const nb of notebooks) {
    const domainObj = allDomains.find(d => d.data.slug === nb.data.domain);
    const subjectObj = allSubjects.find(s => s.data.slug === nb.data.subject);

    // Primary canonical path
    paths.push({
      params: { 
        domain: nb.data.domain, 
        subject: nb.data.subject, 
        slug: nb.data.slug 
      },
      props: { 
        notebook: nb,
        domain: domainObj ? domainObj.data : { title: nb.data.domain, slug: nb.data.domain },
        subject: subjectObj ? subjectObj.data : { title: nb.data.subject, slug: nb.data.subject },
      },
    });

    // Alias paths for backwards compatibility
    if (nb.data.subject === 'logistics-supply-chain') {
      paths.push({
        params: { domain: nb.data.domain, subject: 'lscm', slug: nb.data.slug },
        props: { 
          notebook: nb,
          domain: domainObj ? domainObj.data : { title: nb.data.domain, slug: nb.data.domain },
          subject: subjectObj ? subjectObj.data : { title: nb.data.subject, slug: nb.data.subject },
        },
      });
    } else if (nb.data.subject === 'enterprise-resource-planning') {
      paths.push({
        params: { domain: nb.data.domain, subject: 'erp', slug: nb.data.slug },
        props: { 
          notebook: nb,
          domain: domainObj ? domainObj.data : { title: nb.data.domain, slug: nb.data.domain },
          subject: subjectObj ? subjectObj.data : { title: nb.data.subject, slug: nb.data.subject },
        },
      });
    }
  }

  return paths;
}

const { notebook, domain, subject } = Astro.props;
const { Content, headings } = await render(notebook);

// Fetch sister notebooks for quick navigation
const allNotebooks = await getCollection('notebooks');
const sisterNotebooks = allNotebooks.filter(nb => nb.data.subject === subject.slug);
const currentIndex = sisterNotebooks.findIndex(nb => nb.data.slug === notebook.data.slug);
const prevNotebook = currentIndex > 0 ? sisterNotebooks[currentIndex - 1] : null;
const nextNotebook = currentIndex < sisterNotebooks.length - 1 ? sisterNotebooks[currentIndex + 1] : null;
---

<BaseLayout 
  title={`${notebook.data.title} · ${subject.title} · Brain Knowledge Library`}
  description={notebook.data.description}
>
  <!-- Standard Top Notebook Controls: [ Index ] [ Search 🔍 ] [ Focus ] [ Light/Dark ] [ Progress ] [ Print ] -->
  <NotebookToolbar 
    title={notebook.data.title} 
    domain={domain} 
    subject={subject} 
    slug={notebook.data.slug} 
  />

  <!-- Mobile Slide-Out Sheet for 9-Section Index -->
  <Sheet id="mobile-index-sheet" title={`${notebook.data.title} — Index`}>
    <NotebookSidebar 
      headings={headings}
      notebook={notebook.data}
      sisterNotebooks={sisterNotebooks}
      currentSlug={notebook.data.slug}
      domainSlug={domain.slug}
      subjectSlug={subject.slug}
    />
  </Sheet>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-6">

    <!-- Main Grid: Left 9-Section TOC Sidebar + Paper Sheet Canvas -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT SIDEBAR: 9-Section Structured Index & Metadata (Desktop) -->
      <div id="notebook-sidebar-container" class="hidden lg:block lg:col-span-3 sticky top-20">
        <NotebookSidebar 
          headings={headings}
          notebook={notebook.data}
          sisterNotebooks={sisterNotebooks}
          currentSlug={notebook.data.slug}
          domainSlug={domain.slug}
          subjectSlug={subject.slug}
        />
      </div>

      <!-- MAIN READING CANVAS: Physical Academic Paper Notebook -->
      <main class="notebook-canvas-container lg:col-span-9 transition-all">
        <article class="notebook-sheet p-6 sm:p-12 md:p-16 rounded-2xl border-2 border-[var(--line)] bg-[var(--paper)] shadow-paper-lg relative overflow-hidden">
          
          <!-- Sticky notebook tab flag -->
          <div class="tabflag" aria-label="CANONICAL ACADEMIC EDITION">
            CANONICAL EDITION
          </div>

          <!-- Notebook Masthead -->
          <header class="pb-8 mb-8 border-b-2 border-[var(--rule)] relative">
            <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[var(--pencil)] mb-4">
              <div class="flex items-center space-x-2">
                <span class="rubber-stamp stamp-green text-[10px]">VERIFIED KNOWLEDGE</span>
                <span class="rubber-stamp stamp-blue text-[10px]">PAPER NOTEBOOK 2.0</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="uppercase font-bold text-[var(--ink)]">{domain.title}</span>
                <span>•</span>
                <span>{subject.title}</span>
              </div>
            </div>

            <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--ink)] tracking-tight leading-tight">
              {notebook.data.title}
            </h1>

            <p class="mt-4 text-base sm:text-lg text-[var(--pencil)] leading-relaxed font-sans max-w-3xl">
              {notebook.data.description}
            </p>

            <div class="mt-6 pt-4 border-t border-[var(--rule)] flex flex-wrap items-center gap-4 text-xs font-mono text-[var(--pencil)]">
              {notebook.data.professor && (
                <div><span class="text-[var(--text)] font-semibold">Faculty Lead:</span> {notebook.data.professor}</div>
              )}
              <div><span class="text-[var(--text)] font-semibold">Updated:</span> {notebook.data.updated}</div>
              <div><span class="text-[var(--text)] font-semibold">Format:</span> Canonical MDX (Proof-Engineered)</div>
              {notebook.data.readingTimeMinutes && (
                <div><span class="text-[var(--text)] font-semibold">Reading Time:</span> ~{notebook.data.readingTimeMinutes} min</div>
              )}
            </div>
          </header>

          <!-- Rendered MDX Content with Full Paper Component Suite -->
          <div class="prose prose-stone max-w-none prose-headings:font-serif prose-headings:text-[var(--ink)] prose-a:text-[var(--ink2)] prose-code:font-mono prose-code:bg-[var(--card)] prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:border prose-code:border-[var(--line)] leading-relaxed">
            <Content components={{
              StickyNote,
              Stamp,
              Callout,
              FormulaCard,
              WorkedExample,
              ProcessDiagram,
              PYQSection,
              PYQCard,
              AppendixRegister,
              ComparisonCard,
              DiagramCard,
              QuestionCard,
              Flashcard,
              Quiz,
              RelatedKnowledge,
              Highlighter,
              HandwrittenAnnotation
            }} />
          </div>

          <!-- Notebook Colophon & Navigation Footer -->
          <footer class="mt-16 pt-8 border-t-2 border-[var(--rule)] space-y-6">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
              <div class="text-[var(--pencil)]">
                BRAIN Knowledge OS // {domain.slug} // {subject.slug} // {notebook.data.slug}
              </div>
              <div class="flex items-center space-x-3">
                <a 
                  href={`/${domain.slug}/${subject.slug}/notebooks/${notebook.data.slug}/print/`}
                  target="_blank"
                  class="hover:text-[var(--ink)] hover:underline flex items-center space-x-1"
                >
                  <span>🖨</span>
                  <span>Print Edition</span>
                </a>
                <span>•</span>
                <a href={`/${domain.slug}/${subject.slug}/`} class="hover:text-[var(--ink)] hover:underline">
                  ← Back to Subject Desk
                </a>
              </div>
            </div>

            <!-- Previous / Next Notebook Navigation -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-[var(--rule)]">
              {prevNotebook ? (
                <a 
                  href={`/${domain.slug}/${subject.slug}/notebooks/${prevNotebook.data.slug}/`}
                  class="p-4 rounded-xl bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] transition-colors group"
                >
                  <span class="font-mono text-[10px] text-[var(--pencil)] uppercase tracking-wider">← Previous Notebook</span>
                  <div class="font-serif text-sm font-bold text-[var(--ink)] group-hover:underline mt-1 truncate">
                    {prevNotebook.data.title}
                  </div>
                </a>
              ) : <div></div>}

              {nextNotebook ? (
                <a 
                  href={`/${domain.slug}/${subject.slug}/notebooks/${nextNotebook.data.slug}/`}
                  class="p-4 rounded-xl bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] transition-colors text-right group"
                >
                  <span class="font-mono text-[10px] text-[var(--pencil)] uppercase tracking-wider">Next Notebook →</span>
                  <div class="font-serif text-sm font-bold text-[var(--ink)] group-hover:underline mt-1 truncate">
                    {nextNotebook.data.title}
                  </div>
                </a>
              ) : <div></div>}
            </div>
          </footer>

        </article>
      </main>

    </div>

  </div>
</BaseLayout>
