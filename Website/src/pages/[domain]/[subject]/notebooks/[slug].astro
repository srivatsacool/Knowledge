---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

import StickyNote from '../../../../components/paper/StickyNote.astro';
import Stamp from '../../../../components/paper/Stamp.astro';
import Callout from '../../../../components/paper/Callout.astro';
import FormulaCard from '../../../../components/paper/FormulaCard.astro';
import ComparisonCard from '../../../../components/paper/ComparisonCard.astro';
import DiagramCard from '../../../../components/paper/DiagramCard.astro';
import QuestionCard from '../../../../components/paper/QuestionCard.astro';
import Flashcard from '../../../../components/paper/Flashcard.astro';
import Quiz from '../../../../components/paper/Quiz.astro';
import RelatedKnowledge from '../../../../components/paper/RelatedKnowledge.astro';
import Highlighter from '../../../../components/paper/Highlighter.astro';
import HandwrittenAnnotation from '../../../../components/paper/HandwrittenAnnotation.astro';

export async function getStaticPaths() {
  const notebooks = await getCollection('notebooks');
  const allDomains = await getCollection('domains');
  const allSubjects = await getCollection('subjects');

  const paths = [];

  for (const nb of notebooks) {
    const domainObj = allDomains.find(d => d.data.slug === nb.data.domain);
    const subjectObj = allSubjects.find(s => s.data.slug === nb.data.subject);

    // Primary canonical path
    paths.push({
      params: { 
        domain: nb.data.domain, 
        subject: nb.data.subject, 
        slug: nb.data.slug 
      },
      props: { 
        notebook: nb,
        domain: domainObj ? domainObj.data : { title: nb.data.domain, slug: nb.data.domain },
        subject: subjectObj ? subjectObj.data : { title: nb.data.subject, slug: nb.data.subject },
      },
    });

    // Alias paths
    if (nb.data.subject === 'logistics-supply-chain') {
      paths.push({
        params: { domain: nb.data.domain, subject: 'lscm', slug: nb.data.slug },
        props: { 
          notebook: nb,
          domain: domainObj ? domainObj.data : { title: nb.data.domain, slug: nb.data.domain },
          subject: subjectObj ? subjectObj.data : { title: nb.data.subject, slug: nb.data.subject },
        },
      });
    } else if (nb.data.subject === 'enterprise-resource-planning') {
      paths.push({
        params: { domain: nb.data.domain, subject: 'erp', slug: nb.data.slug },
        props: { 
          notebook: nb,
          domain: domainObj ? domainObj.data : { title: nb.data.domain, slug: nb.data.domain },
          subject: subjectObj ? subjectObj.data : { title: nb.data.subject, slug: nb.data.subject },
        },
      });
    }
  }

  return paths;
}

const { notebook, domain, subject } = Astro.props;
const { Content, headings } = await render(notebook);

// Filter table of contents for h1, h2, h3
const tocHeadings = headings.filter(h => h.depth <= 3);

// Fetch sister notebooks for quick navigation
const allNotebooks = await getCollection('notebooks');
const sisterNotebooks = allNotebooks.filter(nb => nb.data.subject === subject.slug);
const currentIndex = sisterNotebooks.findIndex(nb => nb.data.slug === notebook.data.slug);
const prevNotebook = currentIndex > 0 ? sisterNotebooks[currentIndex - 1] : null;
const nextNotebook = currentIndex < sisterNotebooks.length - 1 ? sisterNotebooks[currentIndex + 1] : null;
---

<BaseLayout 
  title={`${notebook.data.title} · ${subject.title} · Brain`}
  description={notebook.data.description}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-16 left-0 h-1 bg-[var(--ink2)] z-50 transition-all duration-75" style="width: 0%"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">

    <!-- Top Breadcrumb & Actions -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[var(--line)]">
      <nav class="flex items-center space-x-2 text-xs font-mono text-[var(--pencil)]">
        <a href="/" class="hover:text-[var(--ink)] hover:underline">Brain</a>
        <span>/</span>
        <a href={`/${domain.slug}/`} class="hover:text-[var(--ink)] hover:underline">{domain.title}</a>
        <span>/</span>
        <a href={`/${domain.slug}/${subject.slug}/`} class="hover:text-[var(--ink)] hover:underline">{subject.title}</a>
        <span>/</span>
        <span class="text-[var(--ink)] font-bold truncate max-w-xs">{notebook.data.title}</span>
      </nav>

      <div class="flex items-center space-x-3">
        <a 
          href={`/${domain.slug}/${subject.slug}/notebooks/${notebook.data.slug}/print/`}
          target="_blank"
          class="px-3 py-1.5 rounded bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] font-mono text-xs text-[var(--text)] hover:text-[var(--ink)] flex items-center space-x-1.5 shadow-xs transition-colors"
          title="Print or Export to PDF"
        >
          <span>🖨</span>
          <span>Print / PDF</span>
        </a>
        <a 
          href={`/${domain.slug}/${subject.slug}/`}
          class="px-3 py-1.5 rounded bg-[var(--paper)] border border-[var(--line)] hover:border-[var(--ink)] font-mono text-xs text-[var(--pencil)] hover:text-[var(--ink)] transition-colors"
        >
          ← Subject Desk
        </a>
      </div>
    </div>

    <!-- Main Grid: Sticky Sidebar TOC + Paper Sheet Reading Canvas -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT SIDEBAR: Table of Contents & Metadata (Desktop) -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-6">
        
        <!-- Metadata Box -->
        <div class="paper-card p-5 rounded-lg border border-[var(--line)] bg-[var(--card)] space-y-3">
          <div class="flex items-center justify-between">
            <span class="rubber-stamp stamp-green text-[9px]">v{notebook.data.version}</span>
            <span class="font-mono text-[10px] text-[var(--pencil)]">{notebook.data.status.toUpperCase()}</span>
          </div>

          <div class="text-xs space-y-1 font-mono text-[var(--pencil)]">
            <div><span class="text-[var(--text)] font-semibold">Updated:</span> {notebook.data.updated}</div>
            {notebook.data.professor && (
              <div><span class="text-[var(--text)] font-semibold">Lead:</span> {notebook.data.professor}</div>
            )}
            {notebook.data.readingTimeMinutes && (
              <div><span class="text-[var(--text)] font-semibold">Time:</span> ~{notebook.data.readingTimeMinutes} min</div>
            )}
          </div>

          {notebook.data.tags && notebook.data.tags.length > 0 && (
            <div class="pt-2 border-t border-[var(--rule)] flex flex-wrap gap-1">
              {notebook.data.tags.map(t => (
                <span class="text-[9px] font-mono text-[var(--pencil)] bg-[var(--paper)] px-1.5 py-0.5 rounded border border-[var(--line)]">
                  #{t}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Table of Contents -->
        {tocHeadings.length > 0 && (
          <nav class="paper-card p-5 rounded-lg border border-[var(--line)] bg-[var(--card)] max-h-[60vh] overflow-y-auto space-y-2">
            <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--pencil)] font-bold mb-2 pb-1 border-b border-[var(--rule)]">
              Notebook Outline:
            </div>
            <ul class="space-y-1.5 text-xs font-sans">
              {tocHeadings.map(h => (
                <li class={`leading-snug ${h.depth === 1 ? 'font-bold text-[var(--ink)]' : h.depth === 2 ? 'pl-2 text-[var(--pencil)] hover:text-[var(--ink)]' : 'pl-4 text-[var(--pencil)] text-[11px]'}`}>
                  <a href={`#${h.slug}`} class="hover:underline block truncate">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <!-- Sister Notebooks Nav -->
        {sisterNotebooks.length > 1 && (
          <div class="paper-card p-4 rounded-lg border border-[var(--line)] bg-[var(--paper)] space-y-2">
            <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--pencil)] font-bold">
              Subject Notebooks:
            </div>
            <ul class="space-y-1 text-xs">
              {sisterNotebooks.map(nb => (
                <li>
                  <a 
                    href={`/${domain.slug}/${subject.slug}/notebooks/${nb.data.slug}/`}
                    class={`block truncate hover:underline ${nb.data.slug === notebook.data.slug ? 'font-bold text-[var(--ink)]' : 'text-[var(--pencil)]'}`}
                  >
                    • {nb.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

      </aside>

      <!-- MAIN CONTENT: Physical Paper Notebook Sheet -->
      <main class="lg:col-span-9">
        <article class="notebook-sheet p-6 sm:p-12 md:p-16 rounded-xl border border-[var(--line)] bg-[var(--paper)] shadow-paper-lg relative overflow-hidden">
          
          <!-- Sticky notebook tab flag -->
          <div class="tabflag" aria-label="PAPER NOTEBOOK">
            CANONICAL EDITION
          </div>

          <!-- Notebook Header Masthead -->
          <header class="pb-8 mb-8 border-b-2 border-[var(--rule)] relative">
            <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[var(--pencil)] mb-4">
              <div class="flex items-center space-x-2">
                <span class="rubber-stamp stamp-green text-[10px]">VERIFIED 100%</span>
                <span class="rubber-stamp stamp-blue text-[10px]">ACADEMIC MASTER</span>
              </div>
              <div class="flex items-center space-x-3">
                <span>{domain.title}</span>
                <span>•</span>
                <span>{subject.title}</span>
              </div>
            </div>

            <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--ink)] tracking-tight leading-tight">
              {notebook.data.title}
            </h1>

            <p class="mt-4 text-base sm:text-lg text-[var(--pencil)] leading-relaxed font-sans max-w-3xl">
              {notebook.data.description}
            </p>

            <div class="mt-6 pt-4 border-t border-[var(--rule)] flex flex-wrap items-center gap-4 text-xs font-mono text-[var(--pencil)]">
              {notebook.data.professor && (
                <div><span class="text-[var(--text)] font-semibold">Faculty Reference:</span> {notebook.data.professor}</div>
              )}
              <div><span class="text-[var(--text)] font-semibold">Updated:</span> {notebook.data.updated}</div>
              <div><span class="text-[var(--text)] font-semibold">Format:</span> Canonical Markdown/MDX</div>
            </div>
          </header>

          <!-- Rendered MDX Content -->
          <div class="prose prose-stone max-w-none prose-headings:font-serif prose-headings:text-[var(--ink)] prose-a:text-[var(--ink2)] prose-code:font-mono prose-code:bg-[var(--card)] prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:border prose-code:border-[var(--line)] leading-relaxed">
            <Content components={{
              StickyNote,
              Stamp,
              Callout,
              FormulaCard,
              ComparisonCard,
              DiagramCard,
              QuestionCard,
              Flashcard,
              Quiz,
              RelatedKnowledge,
              Highlighter,
              HandwrittenAnnotation
            }} />
          </div>

          <!-- Notebook Colophon & Bottom Nav -->
          <footer class="mt-16 pt-8 border-t-2 border-[var(--rule)] space-y-6">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
              <div class="text-[var(--pencil)]">
                Brain Knowledge Library // {domain.slug} // {subject.slug} // {notebook.data.slug}
              </div>
              <div class="flex items-center space-x-2">
                <a 
                  href={`/${domain.slug}/${subject.slug}/notebooks/${notebook.data.slug}/print/`}
                  target="_blank"
                  class="hover:text-[var(--ink)] hover:underline"
                >
                  Print Edition
                </a>
                <span>•</span>
                <a href={`/${domain.slug}/${subject.slug}/`} class="hover:text-[var(--ink)] hover:underline">
                  Back to Subject Desk
                </a>
              </div>
            </div>

            <!-- Previous / Next Notebook Navigation -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-[var(--rule)]">
              {prevNotebook ? (
                <a 
                  href={`/${domain.slug}/${subject.slug}/notebooks/${prevNotebook.data.slug}/`}
                  class="p-4 rounded-lg bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] transition-colors group"
                >
                  <span class="font-mono text-[10px] text-[var(--pencil)] uppercase tracking-wider">← Previous Notebook</span>
                  <div class="font-serif text-sm font-bold text-[var(--ink)] group-hover:underline mt-1 truncate">
                    {prevNotebook.data.title}
                  </div>
                </a>
              ) : <div></div>}

              {nextNotebook ? (
                <a 
                  href={`/${domain.slug}/${subject.slug}/notebooks/${nextNotebook.data.slug}/`}
                  class="p-4 rounded-lg bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] transition-colors text-right group"
                >
                  <span class="font-mono text-[10px] text-[var(--pencil)] uppercase tracking-wider">Next Notebook →</span>
                  <div class="font-serif text-sm font-bold text-[var(--ink)] group-hover:underline mt-1 truncate">
                    {nextNotebook.data.title}
                  </div>
                </a>
              ) : <div></div>}
            </div>
          </footer>

        </article>
      </main>

    </div>

  </div>

  <!-- Client-side Reading Progress Indicator Script -->
  <script is:inline>
    window.addEventListener('scroll', () => {
      const el = document.getElementById('reading-progress');
      if (!el) return;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (totalHeight <= 0) return;
      const progress = (window.scrollY / totalHeight) * 100;
      el.style.width = Math.min(100, Math.max(0, progress)) + '%';
    });
  </script>
</BaseLayout>
