---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import { PROJECTS } from '../../../../data/projects';

export function getStaticPaths() {
  return PROJECTS.filter(p => p.artifacts.includes('revision')).map(p => ({
    params: { domain: p.division, subject: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;

const acronyms = [
  { short: 'SCOR', full: 'Supply Chain Operations Reference', role: 'APICS diagnostic framework spanning 6 Level-1 processes: Plan, Source, Make, Deliver, Return, Enable.' },
  { short: 'CPFR', full: 'Collaborative Planning, Forecasting, and Replenishment', role: 'VICS 9-step inter-enterprise information-sharing process to damp the Bullwhip Effect.' },
  { short: 'S&OP', full: 'Sales and Operations Planning', role: 'Monthly executive consensus process balancing unconstrained demand with factory supply capacity.' },
  { short: 'S&OE', full: 'Sales and Operations Execution', role: 'Granular weekly/daily tactical cadence resolving immediate SKU disruptions.' },
  { short: 'EOQ', full: 'Economic Order Quantity', role: 'Batch size minimizing total annual holding and setup ordering costs under deterministic demand.' },
  { short: 'EPQ', full: 'Economic Production Quantity', role: 'Lot size when goods are produced internally and consumed simultaneously at rates p and d.' },
  { short: 'ROP', full: 'Reorder Point', role: 'Inventory inventory level threshold triggering a replenishment order: ROP = Expected Lead Time Demand + Safety Stock.' },
  { short: 'CSL', full: 'Cycle Service Level', role: 'The probability that all customer demand during replenishment lead time will be satisfied from inventory.' },
  { short: 'ASN', full: 'Advanced Shipping Notice', role: 'EDI 856 digital transmission notifying receiving docks of inbound trailer contents prior to physical arrival.' },
  { short: 'EDI', full: 'Electronic Data Interchange', role: 'Computer-to-computer exchange of standard business transaction documents.' },
  { short: 'MHE', full: 'Material Handling Equipment', role: 'Mechanical gear (forklifts, reach trucks, conveyors, AGVs) facilitating warehouse movement.' },
  { short: 'AS/RS', full: 'Automated Storage and Retrieval System', role: 'High-density, crane-driven computer-controlled racking achieving up to 45m vertical space usage.' },
  { short: 'VNA', full: 'Very Narrow Aisle', role: 'Aisle geometries <1.8m operated by guided turret trucks to maximize pallet storage density.' },
  { short: 'WMS', full: 'Warehouse Management System', role: 'Enterprise software directing dock appointments, put-away algorithms, and wave picking routing.' },
  { short: 'TMS', full: 'Transportation Management System', role: 'Software optimizing multi-stop carrier routing, mode selection, and freight rate auditing.' },
  { short: '3PL', full: 'Third-Party Logistics', role: 'External service provider owning physical trucks and warehouses to execute logistics contracts.' },
  { short: '4PL', full: 'Fourth-Party Logistics', role: 'Non-asset-owning supply chain integrator that manages multiple 3PL providers through a control tower.' },
  { short: 'INCOTERMS', full: 'International Commercial Terms', role: '11 standardized contractual definitions published by the ICC governing global trade risk and freight.' },
  { short: 'EXW', full: 'Ex Works', role: 'Departure term placing minimum obligation on seller; buyer assumes all freight, export, and risk.' },
  { short: 'DDP', full: 'Delivered Duty Paid', role: 'Arrival term placing maximum obligation on seller, including freight, risk, import duty, and delivery to dock.' },
];
---

<ProjectLayout project={project} activeArtifact="revision" pageSubtitle="Last-Minute Revision Blitz">
  
  <!-- Banner -->
  <div class="paper-card rounded-xl p-8 mb-10 bg-gradient-to-br from-white via-[#FAF7F0] to-[#F4EEDD] dark:from-[#1C1917] dark:via-[#171412] dark:to-[#0C0A09] border border-[#E7E5E4] dark:border-[#292524]">
    <div class="flex items-center space-x-2 mb-3">
      <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-[#1E3A8A] text-white dark:bg-[#60A5FA] dark:text-[#0C0A09]">
        Exam Hall Readiness
      </span>
      <span class="text-xs font-mono text-[#78716C] dark:text-[#A8A29E]">
        Rapid Review & Mental Anchors
      </span>
    </div>

    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] dark:text-[#F5F5F4] mb-3">
      High-Impact Revision Blitz & Acronym Directory
    </h2>

    <p class="text-xs sm:text-sm text-[#57534E] dark:text-[#A8A29E] max-w-3xl leading-relaxed">
      Curated specifically for pre-examination triage. Review the 20 foundational supply chain acronyms, the 4 high-frequency exam traps, and the core structural frameworks guaranteed to secure full marks.
    </p>
  </div>

  <!-- 20 Essential Acronyms Grid -->
  <div class="mb-12">
    <h3 class="font-serif text-2xl font-bold text-[#1C1917] dark:text-[#F5F5F4] mb-4 pb-2 border-b border-[#E7E5E4] dark:border-[#292524]">
      20 Essential SCM Acronyms
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {acronyms.map(a => (
        <div class="paper-card rounded-lg p-4 flex flex-col justify-between hover:border-[#1E3A8A] dark:hover:border-[#60A5FA] transition-all">
          <div>
            <div class="font-mono text-base font-bold text-[#1E3A8A] dark:text-[#60A5FA] mb-1">
              {a.short}
            </div>
            <div class="font-serif text-xs font-semibold text-[#1C1917] dark:text-[#F5F5F4] mb-2 leading-snug">
              {a.full}
            </div>
            <p class="text-[11px] text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
              {a.role}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- High-Frequency Exam Traps -->
  <div class="paper-card rounded-xl p-8 bg-[#FAF7F0] dark:bg-[#141210] border border-[#E7E5E4] dark:border-[#292524]">
    <h3 class="font-serif text-2xl font-bold text-[#BE123C] dark:text-[#FB7185] mb-4 pb-2 border-b border-[#E7E5E4] dark:border-[#292524]">
      High-Frequency Exam Hall Traps & Mistakes to Avoid
    </h3>

    <div class="space-y-4 text-xs sm:text-sm text-[#44403C] dark:text-[#D6D3D1]">
      <div class="p-4 bg-white dark:bg-[#1C1917] rounded-lg border-l-4 border-[#BE123C]">
        <strong class="font-serif text-sm font-bold text-[#1C1917] dark:text-[#F5F5F4] block mb-1">
          Trap 1: Confusing INCOTERMS Cost Transfer with Risk Transfer in CIF
        </strong>
        <p class="leading-relaxed">
          Students frequently write that under CIF the seller is responsible for goods lost at sea because they paid the shipping freight. <strong>WRONG!</strong> In CIF, cost and risk decouple: seller pays freight to destination, but risk transfers to the buyer the moment cargo crosses the ship's rail at origin.
        </p>
      </div>

      <div class="p-4 bg-white dark:bg-[#1C1917] rounded-lg border-l-4 border-[#BE123C]">
        <strong class="font-serif text-sm font-bold text-[#1C1917] dark:text-[#F5F5F4] block mb-1">
          Trap 2: Forgetting to Convert Carrying Percentage (i) to Annual Rupee Cost (H)
        </strong>
        <p class="leading-relaxed">
          In EOQ numericals, if holding cost is given as 20%, do NOT plug 0.20 directly into <span is:raw>$\sqrt{2DS/H}$</span>. You must multiply <span is:raw>$i \times C$</span> to get the unit rupee carrying cost <span is:raw>$H = 0.20 \times 250 = \text{₹}50$</span>.
        </p>
      </div>

      <div class="p-4 bg-white dark:bg-[#1C1917] rounded-lg border-l-4 border-[#BE123C]">
        <strong class="font-serif text-sm font-bold text-[#1C1917] dark:text-[#F5F5F4] block mb-1">
          Trap 3: Equating 3PL and 4PL Orchestrators
        </strong>
        <p class="leading-relaxed">
          A 3PL is an asset-based operational provider that moves or stores goods (trucks, godowns). A 4PL is a non-asset-based management consultant / digital integrator that oversees multiple 3PLs on behalf of the client.
        </p>
      </div>

      <div class="p-4 bg-white dark:bg-[#1C1917] rounded-lg border-l-4 border-[#BE123C]">
        <strong class="font-serif text-sm font-bold text-[#1C1917] dark:text-[#F5F5F4] block mb-1">
          Trap 4: Missing the Square Root in Lead Time Variance
        </strong>
        <p class="leading-relaxed">
          When lead time is constant, safety stock is <span is:raw>$SS = Z \cdot \sigma_d \sqrt{L}$</span>. Students frequently forget the square root over L and multiply directly by L, artificially inflating safety buffers by a factor of 3 to 5.
        </p>
      </div>
    </div>
  </div>

</ProjectLayout>
