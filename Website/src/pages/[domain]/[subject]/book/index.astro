---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import { PROJECTS } from '../../../../data/projects';
import { INTERACTIVE_CHAPTERS } from '../../../../data/lscmData';

export function getStaticPaths() {
  return PROJECTS.map(p => ({
    params: { domain: p.division, subject: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
---

<ProjectLayout project={project} activeArtifact="book" pageSubtitle="Interactive Visual Book">
  
  <!-- Papermorph Hero -->
  <div class="paper-card rounded-xl p-8 mb-10 bg-gradient-to-br from-white via-[#FAF7F0] to-[#F4EEDD] dark:from-[#1C1917] dark:via-[#171412] dark:to-[#0C0A09] border border-[#E7E5E4] dark:border-[#292524]">
    <div class="flex items-center space-x-2 mb-3">
      <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-[#B45309] text-white dark:bg-[#F59E0B] dark:text-[#0C0A09]">
        Papermorph Visual Edition
      </span>
      <span class="text-xs font-mono text-[#78716C] dark:text-[#A8A29E]">
        1600×900 Responsive Canvas
      </span>
    </div>

    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] dark:text-[#F5F5F4] mb-3">
      The Dynamic Architecture of Supply Networks
    </h2>

    <p class="text-xs sm:text-sm text-[#57534E] dark:text-[#A8A29E] max-w-3xl leading-relaxed mb-6">
      An interactive conceptual book where supply chain theorems are not memorized passively, but experienced through live visual transformation. Adjust order sizes to see holding and setup cost curves balance, inflate lead-time variance to observe safety buffer bands swell, and shift international transport legs to witness the exact point risk transfers from seller to buyer.
    </p>

    <!-- Visual Teaching Principle Callout -->
    <div class="p-4 bg-white/80 dark:bg-[#24211E]/80 backdrop-blur-xs rounded-lg border border-[#E7E5E4] dark:border-[#44403C] max-w-2xl">
      <div class="text-[10px] font-mono uppercase tracking-wider text-[#B45309] dark:text-[#F59E0B] font-bold mb-1">
        Core Visual Teaching Principle
      </div>
      <p class="text-xs italic text-[#1C1917] dark:text-[#F5F5F4] font-serif">
        "Make the picture explain the idea through change: rearrange, split, merge, balance, simulate, reveal, and animate."
      </p>
    </div>
  </div>

  <!-- Chapters Roster Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {INTERACTIVE_CHAPTERS.map(ch => (
      <div class="paper-card rounded-xl p-6 flex flex-col justify-between hover:shadow-paper-lg transition-all group">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-xs font-bold text-[#B45309] dark:text-[#F59E0B]">
              Chapter {ch.number.toString().padStart(2, '0')}
            </span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#FAF7F0] dark:bg-[#24211E] text-[#78716C] dark:text-[#A8A29E] border border-[#E7E5E4] dark:border-[#44403C]">
              {ch.stageAspect} Stage
            </span>
          </div>

          <h3 class="font-serif text-xl font-bold text-[#1C1917] dark:text-[#F5F5F4] group-hover:text-[#B45309] dark:group-hover:text-[#F59E0B] transition-colors">
            <a href={`/operations/lscm/book/${ch.slug}/`}>
              {ch.title}
            </a>
          </h3>

          <h4 class="text-xs text-[#78716C] dark:text-[#A8A29E] font-medium mt-1">
            {ch.subtitle}
          </h4>

          <p class="text-xs text-[#57534E] dark:text-[#A8A29E] mt-3 leading-relaxed">
            {ch.concept}
          </p>

          <div class="mt-4 pt-3 border-t border-[#E7E5E4] dark:border-[#292524] text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E] space-y-1">
            <div>• {ch.narrationBeats.length} Storyboard Beats</div>
            <div>• {ch.parameters.length} Active Interactive Parameters</div>
            <div>• 1 Embedded Concept Gate Check</div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#E7E5E4] dark:border-[#292524] flex items-center justify-between">
          <a 
            href={`/operations/lscm/book/${ch.slug}/`}
            class="text-xs font-semibold text-[#B45309] dark:text-[#F59E0B] flex items-center space-x-1 group-hover:translate-x-1 transition-transform"
          >
            <span>Launch Visual Stage</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

</ProjectLayout>
