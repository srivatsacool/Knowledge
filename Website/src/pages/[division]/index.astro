---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DIVISIONS } from '../../data/divisions';
import { PROJECTS } from '../../data/projects';

export function getStaticPaths() {
  return DIVISIONS.map(div => ({
    params: { division: div.slug },
    props: { division: div },
  }));
}

const { division } = Astro.props;
const divisionProjects = PROJECTS.filter(p => p.division === division.slug);
---

<BaseLayout 
  title={`${division.title} Catalog`}
  description={division.description}
>
  <div class="border-b border-[#E7E5E4] dark:border-[#292524] bg-[#FAF7F0] dark:bg-[#0C0A09] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#78716C] dark:text-[#A8A29E] mb-3">
        <a href="/" class="hover:text-[#1E3A8A] dark:hover:text-[#60A5FA]">BRAIN</a>
        <span>/</span>
        <span class="text-[#1C1917] dark:text-[#F5F5F4] font-semibold">{division.title}</span>
      </nav>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] dark:text-[#F5F5F4]">
        {division.title} Catalog
      </h1>
      <p class="text-xs sm:text-sm text-[#78716C] dark:text-[#A8A29E] mt-2 max-w-2xl leading-relaxed">
        {division.description}
      </p>

    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-[#E7E5E4] dark:border-[#292524]">
      <h2 class="font-serif text-xl font-bold text-[#1C1917] dark:text-[#F5F5F4]">
        Active Courses & Knowledge Suites ({divisionProjects.length})
      </h2>
    </div>

    {divisionProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {divisionProjects.map(proj => (
          <div class="paper-card rounded-xl p-6 flex flex-col justify-between hover:shadow-paper-lg transition-all group">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#1E3A8A] dark:text-[#60A5FA] font-semibold">
                  {proj.type}
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#047857]/10 text-[#047857] dark:text-[#10B981]">
                  {proj.status}
                </span>
              </div>

              <h3 class="font-serif text-2xl font-bold text-[#1C1917] dark:text-[#F5F5F4] group-hover:text-[#1E3A8A] dark:group-hover:text-[#60A5FA] transition-colors">
                <a href={`/${proj.division}/${proj.slug}/`}>
                  {proj.title}
                </a>
              </h3>

              <p class="text-xs text-[#57534E] dark:text-[#A8A29E] mt-2 leading-relaxed">
                {proj.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5 mt-4">
                {proj.tags.slice(0, 4).map(tag => (
                  <span class="px-2 py-0.5 rounded text-[10px] bg-[#FAF7F0] dark:bg-[#24211E] border border-[#E7E5E4] dark:border-[#44403C] text-[#57534E] dark:text-[#A8A29E] font-mono">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Suite Bar Links -->
            <div class="mt-6 pt-4 border-t border-[#E7E5E4] dark:border-[#292524] flex items-center justify-between">
              <span class="font-mono text-[11px] text-[#78716C] dark:text-[#A8A29E]">
                {proj.stats.topics} Topics • {proj.stats.pyqYears} Yrs PYQs
              </span>
              <a 
                href={`/${proj.division}/${proj.slug}/`}
                class="text-xs font-semibold text-[#1E3A8A] dark:text-[#60A5FA] hover:underline"
              >
                Launch Suite →
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="paper-card rounded-lg p-12 text-center text-xs text-[#78716C] dark:text-[#A8A29E]">
        <p class="font-medium text-sm text-[#1C1917] dark:text-[#F5F5F4] mb-1">Under Active Ingestion</p>
        Projects in this division are currently undergoing the `brain-notebook-forge` intake pipeline. Check back shortly.
      </div>
    )}

  </div>
</BaseLayout>
