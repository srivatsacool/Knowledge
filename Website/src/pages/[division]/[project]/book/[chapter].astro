---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import { PROJECTS } from '../../../../data/projects';
import { INTERACTIVE_CHAPTERS, type InteractiveChapter } from '../../../../data/lscmData';

export function getStaticPaths() {
  const paths: any[] = [];
  PROJECTS.forEach(project => {
    if (project.slug === 'lscm') {
      INTERACTIVE_CHAPTERS.forEach(chapter => {
        paths.push({
          params: {
            division: project.division,
            project: project.slug,
            chapter: chapter.slug,
          },
          props: { project, chapter },
        });
      });
    }
  });
  return paths;
}

interface Props {
  project: any;
  chapter: InteractiveChapter;
}

const { project, chapter } = Astro.props;
---

<ProjectLayout project={project} activeArtifact="book" pageSubtitle={`Chapter ${chapter.number}: ${chapter.title}`}>
  
  <!-- Breadcrumb & Chapter Navigation -->
  <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E7E5E4] dark:border-[#292524]">
    <div class="flex items-center space-x-2 text-xs font-mono text-[#78716C] dark:text-[#A8A29E]">
      <a href={`/${project.division}/${project.slug}/book/`} class="hover:underline">← All Visual Chapters</a>
      <span>/</span>
      <span class="text-[#1C1917] dark:text-[#F5F5F4] font-bold">Chapter {chapter.number}</span>
    </div>

    <div class="text-xs font-mono text-[#B45309] dark:text-[#F59E0B] font-semibold">
      1600×900 Active Stage
    </div>
  </div>

  <!-- Chapter Title -->
  <div class="mb-6">
    <span class="text-xs font-mono uppercase tracking-wider text-[#B45309] dark:text-[#F59E0B] font-bold block mb-1">
      Visual Beat Series • Chapter {chapter.number}
    </span>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] dark:text-[#F5F5F4]">
      {chapter.title}
    </h1>
    <p class="text-xs sm:text-sm text-[#78716C] dark:text-[#A8A29E] mt-1">
      {chapter.subtitle} — {chapter.concept}
    </p>
  </div>

  <!-- THE 1600x900 RESPONSIVE VISUAL STAGE -->
  <div class="paper-card rounded-xl p-4 sm:p-6 mb-8 bg-[#FAF7F0] dark:bg-[#141210] border border-[#E7E5E4] dark:border-[#292524]">
    
    <div class="flex items-center justify-between mb-3 text-xs font-mono text-[#78716C] dark:text-[#A8A29E]">
      <div class="flex items-center space-x-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#10B981] animate-pulse"></span>
        <span class="font-bold text-[#1C1917] dark:text-[#F5F5F4]">Live Simulation Engine</span>
      </div>
      <span>Aspect: 16:9 (1600×900 Vector Canvas)</span>
    </div>

    <!-- Scalable 16:9 Viewport Container -->
    <div class="stage-aspect-ratio shadow-inner">
      <div class="stage-viewport p-4 sm:p-8 flex flex-col justify-between" id="visual-stage-canvas">
        
        <!-- SVG Vector Canvas based on Chapter ID -->
        {chapter.id === 'ch01' && (
          <div class="w-full h-full flex flex-col justify-between">
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#1E3A8A] dark:text-[#60A5FA] font-bold">Y-Axis: Supply Chain Responsiveness</span>
              <span class="text-[#047857] dark:text-[#10B981] font-bold" id="fit-status">Status: Evaluating Alignment</span>
            </div>

            <!-- Coordinate Stage -->
            <div class="relative w-full h-4/5 border border-dashed border-[#D6D3D1] dark:border-[#44403C] rounded-lg overflow-hidden bg-white/70 dark:bg-[#1C1917]/70 flex items-center justify-center">
              
              <!-- Zone of Strategic Fit Diagonal -->
              <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-[#F4EEDD]/40 to-transparent pointer-events-none transform -rotate-12 scale-150"></div>
              
              <svg class="w-full h-full" viewBox="0 0 800 450">
                <!-- Zone of Strategic fit polygon -->
                <polygon points="50,400 200,400 750,50 600,50" fill="rgba(180, 83, 9, 0.08)" stroke="#B45309" stroke-dasharray="4" stroke-width="1.5" />
                <text x="350" y="240" font-family="'Libre Bodoni', serif" font-style="italic" fill="#B45309" font-size="14">Zone of Strategic Fit</text>
                
                <!-- Coordinate Axes -->
                <line x1="50" y1="400" x2="750" y2="400" stroke="#78716C" stroke-width="2" />
                <line x1="50" y1="400" x2="50" y2="50" stroke="#78716C" stroke-width="2" />

                <!-- Target Product Node -->
                <circle id="product-node" cx="550" cy="280" r="16" fill="#BE123C" class="transition-all duration-300 shadow-lg cursor-pointer" />
                <text id="product-node-label" x="550" y="275" font-family="'JetBrains Mono', monospace" fill="#FFFFFF" font-size="10" text-anchor="middle">Product</text>
              </svg>

            </div>

            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#57534E] dark:text-[#A8A29E]">X-Axis: Implied Demand Uncertainty (Certain/Functional ⟶ Volatile/Innovative)</span>
              <span class="text-[#B45309] dark:text-[#F59E0B]" id="telemetry-readout">Mismatch Penalty: 28%</span>
            </div>
          </div>
        )}

        {chapter.id === 'ch02' && (
          <div class="w-full h-full flex flex-col justify-between">
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#1E3A8A] dark:text-[#60A5FA] font-bold">Cartesian Inventory Cost Stage ($TC = C_o + C_h$)</span>
              <span class="text-[#047857] dark:text-[#10B981] font-bold" id="eoq-output">EOQ: 849 units</span>
            </div>

            <!-- Cost Curve Stage -->
            <div class="relative w-full h-4/5 border border-dashed border-[#D6D3D1] dark:border-[#44403C] rounded-lg overflow-hidden bg-white/70 dark:bg-[#1C1917]/70 flex items-center justify-center p-2">
              <svg class="w-full h-full" viewBox="0 0 800 450" id="eoq-svg">
                <!-- Grid Lines -->
                <line x1="50" y1="400" x2="750" y2="400" stroke="#78716C" stroke-width="2" />
                <line x1="50" y1="400" x2="50" y2="50" stroke="#78716C" stroke-width="2" />
                
                <!-- Curves (Dynamic via script) -->
                <path id="holding-line" d="M 50 400 L 750 100" stroke="#BE123C" stroke-width="2" fill="none" />
                <path id="ordering-curve" d="M 60 80 Q 150 350 750 390" stroke="#1E3A8A" stroke-width="2" fill="none" />
                <path id="total-curve" d="M 60 70 Q 300 280 750 220" stroke="#1C1917" stroke-width="3" fill="none" />

                <!-- Equilibrium point marker -->
                <circle id="eoq-dot" cx="300" cy="280" r="8" fill="#047857" />
                <line id="eoq-v-line" x1="300" y1="400" x2="300" y2="280" stroke="#047857" stroke-dasharray="4" stroke-width="1.5" />
                <text id="eoq-label" x="310" y="275" font-family="'JetBrains Mono', monospace" fill="#047857" font-size="12" font-weight="bold">Q* Equilibrium</text>

                <!-- Legend -->
                <text x="620" y="80" fill="#1C1917" font-size="10" font-family="monospace">■ Total Cost</text>
                <text x="620" y="100" fill="#BE123C" font-size="10" font-family="monospace">■ Holding Cost</text>
                <text x="620" y="120" fill="#1E3A8A" font-size="10" font-family="monospace">■ Ordering Cost</text>
              </svg>
            </div>

            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#57534E] dark:text-[#A8A29E]">Batch Order Quantity (Q)</span>
              <span class="text-[#1E3A8A] dark:text-[#60A5FA]" id="total-cost-readout">Min Annual Cost: ₹42,426</span>
            </div>
          </div>
        )}

        {chapter.id === 'ch03' && (
          <div class="w-full h-full flex flex-col justify-between">
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#1E3A8A] dark:text-[#60A5FA] font-bold">Gaussian Density Distribution Stage & Buffer Floor</span>
              <span class="text-[#047857] dark:text-[#10B981] font-bold" id="safety-stock-output">Safety Stock: 60 units</span>
            </div>

            <div class="relative w-full h-4/5 border border-dashed border-[#D6D3D1] dark:border-[#44403C] rounded-lg overflow-hidden bg-white/70 dark:bg-[#1C1917]/70 flex items-center justify-center p-2">
              <svg class="w-full h-full" viewBox="0 0 800 450">
                <!-- Axes -->
                <line x1="50" y1="400" x2="750" y2="400" stroke="#78716C" stroke-width="2" />
                <line x1="400" y1="400" x2="400" y2="50" stroke="#D6D3D1" stroke-dasharray="2" stroke-width="1" />

                <!-- Bell Curve -->
                <path d="M 100 395 C 250 395, 300 100, 400 90 C 500 100, 550 395, 700 395" stroke="#1E3A8A" stroke-width="3" fill="none" />
                <!-- Shaded tail -->
                <path id="shaded-tail" d="M 550 280 C 600 360, 650 395, 700 395 L 550 395 Z" fill="rgba(190, 18, 60, 0.25)" />

                <!-- Cutoff Line -->
                <line id="z-line" x1="550" y1="400" x2="550" y2="150" stroke="#BE123C" stroke-width="2" stroke-dasharray="4" />
                <text id="z-label" x="555" y="140" fill="#BE123C" font-size="11" font-family="monospace">Z = 1.645 (95% CSL)</text>
                <text x="400" y="420" fill="#78716C" font-size="11" font-family="monospace" text-anchor="middle">Mean Demand μ = 720 units</text>
              </svg>
            </div>

            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#57534E] dark:text-[#A8A29E]">Reorder Point (ROP = 780 units)</span>
              <span class="text-[#BE123C] dark:text-[#FB7185]">Stockout Risk α = 5.0%</span>
            </div>
          </div>
        )}

        {(chapter.id === 'ch04' || chapter.id === 'ch05' || chapter.id === 'ch06') && (
          <div class="w-full h-full flex flex-col justify-between">
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#1E3A8A] dark:text-[#60A5FA] font-bold">{chapter.title}: Flow Stage</span>
              <span class="text-[#047857] dark:text-[#10B981] font-bold">Dynamic Node Simulator</span>
            </div>

            <div class="relative w-full h-4/5 border border-dashed border-[#D6D3D1] dark:border-[#44403C] rounded-lg overflow-hidden bg-white/70 dark:bg-[#1C1917]/70 flex items-center justify-center p-4">
              <svg class="w-full h-full" viewBox="0 0 800 450">
                <!-- Echelon Nodes -->
                <rect x="50" y="180" width="120" height="90" rx="8" fill="#1E3A8A" />
                <text x="110" y="230" fill="#FFFFFF" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Node A</text>

                <line x1="170" y1="225" x2="300" y2="225" stroke="#B45309" stroke-width="3" stroke-dasharray="6" />

                <rect x="300" y="180" width="120" height="90" rx="8" fill="#B45309" />
                <text x="360" y="230" fill="#FFFFFF" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Node B</text>

                <line x1="420" y1="225" x2="550" y2="225" stroke="#047857" stroke-width="3" stroke-dasharray="6" />

                <rect x="550" y="180" width="120" height="90" rx="8" fill="#047857" />
                <text x="610" y="230" fill="#FFFFFF" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Node C</text>
              </svg>
            </div>

            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[#57534E] dark:text-[#A8A29E]">Multi-Echelon State</span>
              <span class="text-[#10B981]">Synchronized Flow</span>
            </div>
          </div>
        )}

      </div>
    </div>

    <!-- Active Parameter Controls -->
    <div class="mt-6 pt-4 border-t border-[#E7E5E4] dark:border-[#292524]">
      <h3 class="font-mono text-xs uppercase tracking-wider text-[#78716C] dark:text-[#A8A29E] font-bold mb-3">
        Active Parameter Adjusters
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {chapter.parameters.map(p => (
          <div class="p-3 bg-white dark:bg-[#1C1917] rounded border border-[#E7E5E4] dark:border-[#292524]">
            <div class="flex justify-between text-xs mb-1.5">
              <span class="font-medium text-[#1C1917] dark:text-[#F5F5F4]">{p.name}</span>
              <span class="font-mono text-[#1E3A8A] dark:text-[#60A5FA]" id={`val-${p.id}`}>{p.defaultVal} {p.unit}</span>
            </div>
            <input 
              type="range" 
              id={`slider-${p.id}`}
              min={p.min} 
              max={p.max} 
              step={p.step} 
              value={p.defaultVal}
              class="w-full accent-[#1E3A8A] dark:accent-[#60A5FA] cursor-pointer"
            />
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- STORYBOARD BEATS & NARRATION -->
  <div class="mb-12">
    <h3 class="font-serif text-2xl font-bold text-[#1C1917] dark:text-[#F5F5F4] mb-4 pb-2 border-b border-[#E7E5E4] dark:border-[#292524]">
      Storyboard Beats & Narration
    </h3>

    <div class="space-y-4">
      {chapter.narrationBeats.map(beat => (
        <div class="paper-card rounded-lg p-5 flex items-start space-x-4">
          <span class="font-serif text-2xl font-bold text-[#B45309] dark:text-[#F59E0B] shrink-0 w-8">
            0{beat.beatNumber}
          </span>
          <div class="space-y-1">
            <h4 class="font-serif text-base font-bold text-[#1C1917] dark:text-[#F5F5F4]">
              {beat.title}
            </h4>
            <p class="text-xs sm:text-sm text-[#44403C] dark:text-[#D6D3D1] leading-relaxed">
              "{beat.narration}"
            </p>
            <div class="pt-2 text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E] flex items-center space-x-1">
              <span class="font-semibold text-[#1E3A8A] dark:text-[#60A5FA]">Visual State:</span>
              <span>{beat.visualAction}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- EMBEDDED MICRO-CHECK GATE -->
  <div class="paper-card rounded-xl p-6 bg-gradient-to-br from-white to-[#FAF7F0] dark:from-[#1C1917] dark:to-[#141210] border border-[#E7E5E4] dark:border-[#292524]">
    <div class="flex items-center space-x-2 text-xs font-mono uppercase tracking-wider text-[#047857] dark:text-[#10B981] font-bold mb-2">
      <span>Concept Gate Verification Check</span>
    </div>

    <h3 class="font-serif text-xl font-bold text-[#1C1917] dark:text-[#F5F5F4] mb-3">
      {chapter.quiz.question}
    </h3>

    <div class="space-y-2 mb-4" id="quiz-options">
      {chapter.quiz.options.map((opt, idx) => (
        <button 
          onclick={`handleQuizOption(${idx}, ${chapter.quiz.correctIndex})`}
          class="quiz-btn w-full text-left p-3 rounded-lg border border-[#E7E5E4] dark:border-[#292524] hover:bg-[#FAF7F0] dark:hover:bg-[#24211E] text-xs text-[#292524] dark:text-[#E7E5E4] transition-all cursor-pointer flex items-center justify-between"
          data-index={idx}
        >
          <span>{opt}</span>
          <span class="quiz-indicator font-mono text-xs"></span>
        </button>
      ))}
    </div>

    <div id="quiz-explanation" class="hidden p-4 rounded-lg bg-[#FAF7F0] dark:bg-[#24211E] border border-[#E7E5E4] dark:border-[#44403C] text-xs text-[#44403C] dark:text-[#D6D3D1]">
      <strong class="font-semibold text-[#047857] dark:text-[#10B981] block mb-1">Pedagogical Explanation:</strong>
      {chapter.quiz.explanation}
    </div>
  </div>

</ProjectLayout>

<script is:inline>
  // Simple Quiz Interactivity
  function handleQuizOption(selectedIdx, correctIdx) {
    const buttons = document.querySelectorAll('.quiz-btn');
    const explanation = document.getElementById('quiz-explanation');

    buttons.forEach((btn, idx) => {
      btn.disabled = true;
      const indicator = btn.querySelector('.quiz-indicator');
      if (idx === correctIdx) {
        btn.classList.add('bg-[#047857]/10', 'border-[#047857]', 'text-[#047857]', 'font-semibold');
        if (indicator) indicator.innerText = '✔ Correct';
      } else if (idx === selectedIdx) {
        btn.classList.add('bg-[#BE123C]/10', 'border-[#BE123C]', 'text-[#BE123C]');
        if (indicator) indicator.innerText = '✖ Incorrect';
      }
    });

    if (explanation) {
      explanation.classList.remove('hidden');
    }
  }

  // Dynamic Parameter Slider listeners
  const sUncertainty = document.getElementById('slider-uncertainty');
  const sResp = document.getElementById('slider-responsiveness');
  if (sUncertainty && sResp) {
    function updateStrategicFit() {
      const u = parseFloat(sUncertainty.value);
      const r = parseFloat(sResp.value);
      const node = document.getElementById('product-node');
      const valU = document.getElementById('val-uncertainty');
      const valR = document.getElementById('val-responsiveness');
      const readout = document.getElementById('telemetry-readout');
      const status = document.getElementById('fit-status');

      if (valU) valU.innerText = u + ' %';
      if (valR) valR.innerText = r + ' pts';

      const cx = 50 + (u / 100) * 700;
      const cy = 400 - (r / 100) * 350;

      if (node) {
        node.setAttribute('cx', cx);
        node.setAttribute('cy', cy);
      }

      // Check alignment
      const diff = Math.abs(u - r);
      if (diff < 15) {
        if (status) {
          status.innerText = 'Status: In Strategic Fit Zone';
          status.className = 'text-[#047857] dark:text-[#10B981] font-bold font-mono';
        }
        if (readout) readout.innerText = 'Penalty: Minimal (Optimal ROCE)';
      } else {
        if (status) {
          status.innerText = 'Status: Misaligned Strategy';
          status.className = 'text-[#BE123C] dark:text-[#FB7185] font-bold font-mono';
        }
        if (readout) readout.innerText = `Penalty: ~${Math.round(diff * 0.8)}% margin loss`;
      }
    }
    sUncertainty.addEventListener('input', updateStrategicFit);
    sResp.addEventListener('input', updateStrategicFit);
  }

  // EOQ Slider Listener
  const sDemand = document.getElementById('slider-demand');
  const sSetup = document.getElementById('slider-setup');
  const sHolding = document.getElementById('slider-holding');
  if (sDemand && sSetup && sHolding) {
    function updateEoq() {
      const D = parseFloat(sDemand.value);
      const S = parseFloat(sSetup.value);
      const H = parseFloat(sHolding.value);

      document.getElementById('val-demand').innerText = D.toLocaleString() + ' units';
      document.getElementById('val-setup').innerText = '₹' + S.toLocaleString();
      document.getElementById('val-holding').innerText = '₹' + H + '/unit';

      const eoq = Math.round(Math.sqrt((2 * D * S) / H));
      const totalCost = Math.round(Math.sqrt(2 * D * S * H));

      const eoqOut = document.getElementById('eoq-output');
      const tcOut = document.getElementById('total-cost-readout');
      if (eoqOut) eoqOut.innerText = `EOQ: ${eoq.toLocaleString()} units`;
      if (tcOut) tcOut.innerText = `Min Annual Cost: ₹${totalCost.toLocaleString()}`;

      // Move marker on svg
      const dot = document.getElementById('eoq-dot');
      const vline = document.getElementById('eoq-v-line');
      const label = document.getElementById('eoq-label');
      const scaledX = Math.min(700, Math.max(100, (eoq / 2000) * 300 + 100));
      if (dot) dot.setAttribute('cx', scaledX);
      if (vline) {
        vline.setAttribute('x1', scaledX);
        vline.setAttribute('x2', scaledX);
      }
      if (label) label.setAttribute('x', scaledX + 10);
    }
    sDemand.addEventListener('input', updateEoq);
    sSetup.addEventListener('input', updateEoq);
    sHolding.addEventListener('input', updateEoq);
  }
</script>
