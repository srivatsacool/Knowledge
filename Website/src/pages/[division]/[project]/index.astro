---
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { PROJECTS, type ProjectMetadata } from '../../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map(p => ({
    params: { division: p.division, project: p.slug },
    props: { project: p },
  }));
}

interface Props {
  project: ProjectMetadata;
}

const { project } = Astro.props;
---

<ProjectLayout project={project} activeArtifact="overview">
  
  <!-- Grid: Primary Artifact & Secondary Artifacts -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left Column (2 Cols): Primary Artifact + Secondary Cards -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- PRIMARY ARTIFACT: Master Notebook Banner -->
      <div class="paper-card rounded-xl p-8 border-2 border-[#1E3A8A]/30 dark:border-[#60A5FA]/30 bg-gradient-to-br from-white to-[#FAF7F0] dark:from-[#1C1917] dark:to-[#141210]">
        <div class="flex items-center justify-between mb-3">
          <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-[#1E3A8A] text-white dark:bg-[#60A5FA] dark:text-[#0C0A09]">
            ★ Primary Artifact
          </span>
          <span class="font-mono text-xs text-[#78716C] dark:text-[#A8A29E]">
            {project.stats.topics} Sessions Synthesized
          </span>
        </div>

        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1C1917] dark:text-[#F5F5F4] mb-3">
          Master Exam Notebook
        </h2>

        <p class="text-xs sm:text-sm text-[#44403C] dark:text-[#D6D3D1] leading-relaxed mb-6">
          The unified, high-scoring examination textbook. Synthesizes official course objectives with faculty slide frameworks (Ajit Sir, Manoj Sir, Praful Sir), step-by-step KaTeX mathematical formulations, reproducible exam diagrams, and model answer formats.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a 
            href={`/${project.division}/${project.slug}/notebook/`}
            class="px-5 py-2.5 rounded-lg bg-[var(--ink)] text-white hover:bg-[var(--ink2)] font-medium text-xs sm:text-sm shadow-sm transition-all"
          >
            Open Unified Master Notebook (15 Topics) →
          </a>
        </div>

        {project.slug === 'lscm' && (
          <div class="mt-6 pt-5 border-t border-[var(--line)]">
            <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--ink)] font-bold block mb-2">
              Individual Faculty Portfolios (Paper Edition 2.0 Standalone):
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <a 
                href="/operations/lscm-archive/01_Ajit_Sir_LSCM_Notebook.html" 
                target="_blank" 
                class="p-2.5 rounded bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] block transition-colors group"
              >
                <div class="font-serif text-xs font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] flex items-center justify-between">
                  <span>🏛️ Prof. Ajit Maurya</span>
                  <span class="font-mono text-[10px] opacity-60">↗</span>
                </div>
                <div class="text-[10px] text-[var(--pencil)] mt-0.5">SCM Architecture & 6 Drivers</div>
              </a>
              <a 
                href="/operations/lscm-archive/02_Manoj_Sir_LSCM_Notebook.html" 
                target="_blank" 
                class="p-2.5 rounded bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] block transition-colors group"
              >
                <div class="font-serif text-xs font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] flex items-center justify-between">
                  <span>📦 Prof. Manoj Dagaonkar</span>
                  <span class="font-mono text-[10px] opacity-60">↗</span>
                </div>
                <div class="text-[10px] text-[var(--pencil)] mt-0.5">Warehousing Layout & EXIM</div>
              </a>
              <a 
                href="/operations/lscm-archive/03_Praful_Sir_LSCM_Notebook.html" 
                target="_blank" 
                class="p-2.5 rounded bg-[var(--card)] border border-[var(--line)] hover:border-[var(--ink)] block transition-colors group"
              >
                <div class="font-serif text-xs font-bold text-[var(--ink)] group-hover:text-[var(--ink2)] flex items-center justify-between">
                  <span>🧮 Prof. Praful More</span>
                  <span class="font-mono text-[10px] opacity-60">↗</span>
                </div>
                <div class="text-[10px] text-[var(--pencil)] mt-0.5">Inventory Theory & Kraljic</div>
              </a>
            </div>
          </div>
        )}
      </div>

      <!-- SECONDARY ARTIFACTS Grid -->
      <div>
        <h3 class="font-serif text-xl font-bold text-[#1C1917] dark:text-[#F5F5F4] mb-4 pb-2 border-b border-[#E7E5E4] dark:border-[#292524]">
          Specialized Learning Artifacts
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Interactive Book Card -->
          <a 
            href={`/${project.division}/${project.slug}/book/`}
            class="paper-card rounded-lg p-5 hover:border-[#1E3A8A] dark:hover:border-[#60A5FA] transition-all group block"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#B45309] dark:text-[#F59E0B]">
                🎬 Interactive Book
              </span>
              <span class="text-[10px] font-mono text-[#78716C] dark:text-[#A8A29E]">1600×900 Stage</span>
            </div>
            <h4 class="font-serif text-base font-bold text-[#1C1917] dark:text-[#F5F5F4] group-hover:text-[#1E3A8A] dark:group-hover:text-[#60A5FA]">
              The Dynamic Architecture
            </h4>
            <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mt-1 line-clamp-2">
              Papermorph-inspired visual simulators: active EOQ curves, safety stock Gaussian bands, and INCOTERMS risk handoffs.
            </p>
          </a>

          <!-- PYQ Bank Card -->
          <a 
            href={`/${project.division}/${project.slug}/pyq/`}
            class="paper-card rounded-lg p-5 hover:border-[#1E3A8A] dark:hover:border-[#60A5FA] transition-all group block"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#BE123C] dark:text-[#FB7185]">
                📝 PYQ Intelligence Bank
              </span>
              <span class="text-[10px] font-mono text-[#78716C] dark:text-[#A8A29E]">2023–2025</span>
            </div>
            <h4 class="font-serif text-base font-bold text-[#1C1917] dark:text-[#F5F5F4] group-hover:text-[#1E3A8A] dark:group-hover:text-[#60A5FA]">
              100% Verbatim Past Papers
            </h4>
            <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mt-1 line-clamp-2">
              Strictly non-hallucinated university examination questions with step-by-step numerical solutions and frequency heatmaps.
            </p>
          </a>

          <!-- Formula Book Card -->
          <a 
            href={`/${project.division}/${project.slug}/formulas/`}
            class="paper-card rounded-lg p-5 hover:border-[#1E3A8A] dark:hover:border-[#60A5FA] transition-all group block"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#047857] dark:text-[#10B981]">
                🧮 Formula Book
              </span>
              <span class="text-[10px] font-mono text-[#78716C] dark:text-[#A8A29E]">KaTeX Math</span>
            </div>
            <h4 class="font-serif text-base font-bold text-[#1C1917] dark:text-[#F5F5F4] group-hover:text-[#1E3A8A] dark:group-hover:text-[#60A5FA]">
              Formula & Proof Directory
            </h4>
            <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mt-1 line-clamp-2">
              Comprehensive inventory and logistics mathematical formulations with explicit variable dictionaries and arithmetic proofs.
            </p>
          </a>

          <!-- Revision Card -->
          <a 
            href={`/${project.division}/${project.slug}/revision/`}
            class="paper-card rounded-lg p-5 hover:border-[#1E3A8A] dark:hover:border-[#60A5FA] transition-all group block"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#1E3A8A] dark:text-[#60A5FA]">
                ⚡ Revision Blitz
              </span>
              <span class="text-[10px] font-mono text-[#78716C] dark:text-[#A8A29E]">Last-Minute</span>
            </div>
            <h4 class="font-serif text-base font-bold text-[#1C1917] dark:text-[#F5F5F4] group-hover:text-[#1E3A8A] dark:group-hover:text-[#60A5FA]">
              High-Impact Blitz & Acronyms
            </h4>
            <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mt-1 line-clamp-2">
              20 essential acronyms, core concept memory triggers, and high-frequency exam trap warnings.
            </p>
          </a>

        </div>
      </div>

    </div>

    <!-- Right Column (1 Col): Stats, Updates, Related Projects -->
    <div class="space-y-6">
      
      <!-- Project Statistics Card -->
      <div class="paper-card rounded-lg p-5">
        <h4 class="font-serif text-sm font-bold text-[#1C1917] dark:text-[#F5F5F4] uppercase tracking-wider mb-4 pb-2 border-b border-[#E7E5E4] dark:border-[#292524]">
          Project Statistics
        </h4>

        <div class="grid grid-cols-2 gap-4 text-center">
          <div class="p-3 bg-[#FAF7F0] dark:bg-[#141210] rounded border border-[#E7E5E4] dark:border-[#292524]">
            <span class="font-serif text-2xl font-bold text-[#1C1917] dark:text-[#F5F5F4] block">
              {project.stats.topics}
            </span>
            <span class="text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E]">Syllabus Topics</span>
          </div>
          <div class="p-3 bg-[#FAF7F0] dark:bg-[#141210] rounded border border-[#E7E5E4] dark:border-[#292524]">
            <span class="font-serif text-2xl font-bold text-[#1E3A8A] dark:text-[#60A5FA] block">
              {project.stats.notebooks}
            </span>
            <span class="text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E]">Notebooks</span>
          </div>
          <div class="p-3 bg-[#FAF7F0] dark:bg-[#141210] rounded border border-[#E7E5E4] dark:border-[#292524]">
            <span class="font-serif text-2xl font-bold text-[#B45309] dark:text-[#F59E0B] block">
              {project.stats.chapters}
            </span>
            <span class="text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E]">Visual Chapters</span>
          </div>
          <div class="p-3 bg-[#FAF7F0] dark:bg-[#141210] rounded border border-[#E7E5E4] dark:border-[#292524]">
            <span class="font-serif text-2xl font-bold text-[#047857] dark:text-[#10B981] block">
              {project.stats.pyqYears}
            </span>
            <span class="text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E]">PYQ Exam Years</span>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-[#E7E5E4] dark:border-[#292524] text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E] space-y-1">
          <div class="flex justify-between">
            <span>Created:</span>
            <span class="text-[#1C1917] dark:text-[#F5F5F4]">{project.created}</span>
          </div>
          <div class="flex justify-between">
            <span>Last Updated:</span>
            <span class="text-[#1C1917] dark:text-[#F5F5F4]">{project.updated}</span>
          </div>
        </div>
      </div>

      <!-- Recent Updates -->
      {project.recentUpdates && (
        <div class="paper-card rounded-lg p-5">
          <h4 class="font-serif text-sm font-bold text-[#1C1917] dark:text-[#F5F5F4] uppercase tracking-wider mb-3 pb-2 border-b border-[#E7E5E4] dark:border-[#292524]">
            Recent Pipeline Updates
          </h4>
          <ul class="space-y-2 text-xs text-[#57534E] dark:text-[#A8A29E]">
            {project.recentUpdates.map(u => (
              <li class="flex items-start space-x-2">
                <span class="text-[#1E3A8A] dark:text-[#60A5FA] font-bold">✓</span>
                <span class="leading-relaxed">{u}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Related Projects -->
      {project.relatedProjects && (
        <div class="paper-card rounded-lg p-5">
          <h4 class="font-serif text-sm font-bold text-[#1C1917] dark:text-[#F5F5F4] uppercase tracking-wider mb-3 pb-2 border-b border-[#E7E5E4] dark:border-[#292524]">
            Related Projects
          </h4>
          <div class="space-y-2">
            {project.relatedProjects.map(rel => {
              const relProject = PROJECTS.find(p => p.slug === rel);
              if (!relProject) return null;
              return (
                <a 
                  href={`/${relProject.division}/${relProject.slug}/`}
                  class="block p-2.5 rounded bg-[#FAF7F0] dark:bg-[#141210] border border-[#E7E5E4] dark:border-[#292524] hover:border-[#1E3A8A] dark:hover:border-[#60A5FA] transition-colors"
                >
                  <div class="font-serif text-xs font-bold text-[#1C1917] dark:text-[#F5F5F4]">
                    {relProject.title}
                  </div>
                  <div class="text-[10px] text-[#78716C] dark:text-[#A8A29E] font-mono mt-0.5">
                    {relProject.division} • {relProject.stats.topics} Topics
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

    </div>

  </div>
</ProjectLayout>
